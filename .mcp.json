{
  "mcpServers": {
    "flint-chart": {
      "command": "npx",
      "args": ["-y", "flint-chart-mcp"],
      "env": {}
    },
    "qwen-mm-plugins-core": {
      "command": "uvx",
      "args": [
        "--from",
        "qwen-mm-plugins[core] @ git+https://github.com/QwenLM/Qwen-MM-Plugins.git@qwen-mm-plugins-core-v1.0.2",
        "qwen-mm-plugins-core"
      ],
      "env": {}
    },
    "vision-pixel": {
      "command": "/root/.pyenv/versions/3.14.7/bin/python",
      "args": ["/workspace/servers/vision-pixel-mcp/server.py"],
      "env": {}
    }
  }
}
