[Unit]
Description=Huginn AI Agent Server (FastAPI + WebSocket)
Documentation=https://github.com/toki0413/matsci
# 等待网络就绪后再启动, 确保 MCP server / 外部服务可达
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 运行工作目录 — huginn.toml 从该目录加载, 即为"固化"的生效配置
WorkingDirectory=/workspace/agent
# 使用项目自带 Python 解释器 (含 mcp 依赖), 避免子进程用错系统 python
ExecStart=/root/.pyenv/versions/3.12.13/bin/python -m huginn.server --port 8000

# 崩溃自动重启
Restart=always
RestartSec=5
# 防止瞬间崩溃造成无限重启风暴
StartLimitIntervalSec=60
StartLimitBurst=5

# 生产鉴权: 从 /etc/huginn/huginn.env 读取 HUGINN_API_KEY + HUGINN_JWT_SECRET.
# 不再使用 HUGINN_DEV_MODE (会豁免本机鉴权). 缺失时 auth 依赖会拒绝所有非公开请求.
EnvironmentFile=/etc/huginn/huginn.env

# ── 路径沙箱工作区 ──
# HUGINN_WORKSPACE 定义 agent 可读写的作用域 (来自 huginn.env, 默认 /data/huginn).
# 路径沙箱 allowed_work_dirs 由此推出, 越权路径会被 SandboxError 拦截.
# 如迁移数据目录, 改 huginn.env 里的 HUGINN_WORKSPACE 即可, 无需动本文件.

# ── HPC 集群 ──
# 真实 Slurm/PBS 配置固化在 huginn.env 的 HPC_* 段 (经下方 EnvironmentFile 注入).
# 但 HUGINN_CONFIG_FILE(=huginn.toml) 为 file-first, 其 hpc_* 字段优先于 HPC_* 环境变量.
# 因此接真实集群时, 应改 huginn.toml 的:
#   execution_backend = "remote" / hpc_scheduler = "slurm" | "pbs"
#   hpc_host / hpc_username / hpc_key_path 或 hpc_password
#   hpc_default_queue / hpc_gpu_queue / hpc_queue_map
# 认证走 paramiko SSH. 私钥优先: 放 /root/.ssh/ (chmod 600), HPC_KEY_PATH 指向它;
#   无私钥则用 HPC_PASSWORD. HPC_STRICT_HOST_KEY_CHECKING=true 时 known_hosts 须有主机指纹.
# 连接惰性, 集群不可达仅禁用远程准入, 不阻塞服务启动.

[Install]
# 多用户目标 — 开机自启
WantedBy=multi-user.target