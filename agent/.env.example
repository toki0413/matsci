# Huginn Agent 环境变量示例
# 复制为 .env 并填入真实值. .env 已在 .gitignore 中, 不会被提交.

# ── 必填 (生产环境) ──────────────────────────────────
# API 认证密钥, 客户端必须在 Authorization 头里带上. 强随机字符串, 至少 32 字节.
HUGINN_API_KEY=change-me-to-a-strong-random-string

# ── 模型配置 ────────────────────────────────────────
# 至少配置一个 LLM provider 的 API key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── 数据库 (docker-compose 用) ──────────────────────
POSTGRES_USER=huginn
POSTGRES_PASSWORD=change-me-to-strong-random
POSTGRES_DB=huginn
REDIS_PASSWORD=change-me-to-strong-random

# ── 可选: 安全相关 ──────────────────────────────────
# CORS 允许的源, 留空表示同源, 生产环境应明确列出
HUGINN_CORS_ORIGINS=
# 每分钟每 API key 的请求上限, 0=禁用限流
HUGINN_RATE_LIMIT_PER_MINUTE=60
# 容器运行时 (none/docker/podman), 用于沙箱隔离
HUGINN_CONTAINER_RUNTIME=none
# 严格 SSH host key 校验, 生产环境应为 true
HUGINN_STRICT_HOST_KEY_CHECKING=true

# ── 可选: 工作区 ────────────────────────────────────
HUGINN_WORKSPACE=./workspace
# 缓存目录, 存 SQLite/索引等
HUGINN_CACHE_DIR=
