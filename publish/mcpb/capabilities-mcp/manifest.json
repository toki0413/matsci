{
  "$schema": "https://json.schemastore.org/mcpb.json",
  "manifest_version": "0.4",
  "name": "capabilities-mcp",
  "version": "0.1.0",
  "description": "Huginn capability-container MCP server — read-only exposure of 150+ composable/exportable agent capabilities (atomic + composite) over MCP",
  "author": {
    "name": "Huginn contributors",
    "url": "https://github.com/toki0413/matsci"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toki0413/matsci"
  },
  "license": "MIT",
  "keywords": ["mcp", "agent", "capability", "llm", "huginn", "scientific-research"],
  "tools": [],
  "server": {
    "type": "python",
    "entry_point": "mcp_entry:main",
    "mcp_config": {
      "command": "python",
      "args": ["mcp_entry.py"]
    }
  },
  "compatibility": {
    "claude_desktop": ">=20250501",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": { "python": ">=3.11" }
  }
}