import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        poly_X = poly_basis(X, 3)
        y = (poly_X @ coeffs).reshape(-1, 1)
        poly_Xv = poly_basis(Xv, 3)
        yv = (poly_Xv @ coeffs).reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        poly_X = poly_basis(X, 10)
        y = (poly_X @ coeffs).reshape(-1, 1)
        poly_Xv = poly_basis(Xv, 10)
        yv = (poly_Xv @ coeffs).reshape(-1, 1)
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [4, 8, 16, 32]
    hs = [4, 8, 16, 32]
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'score': 0.0}
    for kind in ['rigid', 'fat']:
        Nc_list = []
        for w in ws:
            Nc_found = None
            for h in hs:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                yv_pred = mlp_predict(model, Xv)
                err = np.max(np.abs(yv_pred - yv))
                if err <= 1e-3:
                    Nc_found = h
                    break
            Nc_list.append(Nc_found if Nc_found is not None else 999)
        summary[f'{kind}_Nc'].append(Nc_list)
        rigid_plateau = all(n < 50 for n in summary['rigid_Nc'])
        fat_fail = all(n >= 999 for n in summary['fat_Nc'])
        objectives['score'] = (1.0 if rigid_plateau else 0.0) + (1.0 if fat_fail else 0.0)
    return {'success': True, 'summary': summary, 'objectives': objectives}
