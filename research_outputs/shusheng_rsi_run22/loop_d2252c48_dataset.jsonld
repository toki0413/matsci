    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef family(kind, w, seed):\n    # ===== 你只改这个函数: 定义\"刚(rigid)/肥(fat)\"各自对应的约束族 =====\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        # 刚性族：低维唯一解 —— 线性函数 y = 2x + 1，解析解唯一\n        X = rng.uniform(-1.0, 1.0, w).reshape(-1, 1)\n        y = 2.0 * X + 1.0\n        Xv = np.linspace(-1.0, 1.0, 200).reshape(-1, 1)\n        yv = 2.0 * Xv + 1.0\n    elif kind == 'fat':\n        # 肥族：高维连续族 —— 所有满足 y(x) >= 0 且 y(0)=1 的函数，构造为 y = a*x + 1, a ∈ R\n        X = rng.uniform(-1.0, 1.0, w).reshape(-1, 1)\n        a = rng.uniform(-2.0, 2.0, 1)  # 每个种子选一个 a，但族本身是高维（a连续）\n        y = a * X + 1.0\n        Xv = np.linspace(-1.0, 1.0, 200).reshape(-1, 1)\n        yv = a * Xv + 1.0\n    else:\n        raise ValueError(f\"Unknown kind: {kind}\")\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    return capacity_scan(family, seed=seed)"
    },
