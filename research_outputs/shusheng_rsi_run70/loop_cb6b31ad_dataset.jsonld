    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(10)\n        X_high = np.concatenate([X, rng.uniform(0, 1, (w, 1))], axis=1)\n        Xv_high = np.concatenate([Xv, rng.uniform(0, 1, (200, 1))], axis=1)\n        y = poly_basis(X_high, 10) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv_high, 10) @ coeffs.reshape(-1, 1)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [5, 10]\n    hs = [3, 4, 5]\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'score': 0.0}\n    scale = None\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        for w in ws:\n            Nc_found = None\n            for h in hs:\n                data = family(kind, w, seed + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                if scale is None:\n                    scale = np.std(np.concatenate([y, yv]))\n                y_norm = y / scale\n                yv_norm = yv / scale\n                X_norm = X / scale\n                Xv_norm = Xv / scale\n                model = mlp_fit(X_norm, y_norm, h, seeds=1)\n                y_pred = mlp_predict(model, Xv_norm)\n                err = np.max(np.abs(y_pred - yv_norm))\n                if zero_violation(err):\n                    if Nc_found is None:\n                        Nc_found = h\n                    break\n            if Nc_found is None:\n                Nc_found = 999.0\n            Nc_list.append(Nc_found)\n            summary[f'{kind}_w{w}'] = Nc_found\n        summary[f'{kind}_Nc_avg'] = float(np.mean(Nc_list))\n        summary[f'{kind}_Nc_final'] = float(Nc_list[-1])\n        if kind == 'rigid' and Nc_list[-1] < 20:\n            objectives['score'] += 1.0\n        elif kind == 'fat' and Nc_list[-1] >= 900:\n            objectives['score'] += 1.0\n    summary['note'] = 'rigid: Nc plateaus; fat: Nc unbounded'\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
