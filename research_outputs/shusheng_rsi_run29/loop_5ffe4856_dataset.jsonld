    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        x = np.linspace(-1.0, 1.0, w).reshape(-1, 1)\n        y = np.cos(np.pi * x)\n        Xv = np.linspace(-0.9, 0.9, 200).reshape(-1, 1)\n        yv = np.cos(np.pi * Xv)\n        return {'X': x, 'y': y, 'Xv': Xv, 'yv': yv}\n    elif kind == 'fat':\n        x = np.linspace(-1.0, 1.0, w).reshape(-1, 1)\n        coeffs = rng.standard_normal((20, 1))\n        y = sum(coeffs[i] * (2 * x - 1)**i for i in range(20))\n        Xv = np.linspace(-0.9, 0.9, 200).reshape(-1, 1)\n        yv = sum(coeffs[i] * (2 * Xv - 1)**i for i in range(20))\n        return {'X': x, 'y': y, 'Xv': Xv, 'yv': yv}\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    return capacity_scan(family, seed=seed)"
    },
