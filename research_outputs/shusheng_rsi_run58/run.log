import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 100), 10) @ coeffs)
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [5, 10, 20, 30, 40, 50, 60]
    hs = list(range(10, 201, 10))
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'rigid_Nc_mean': 0.0, 'fat_Nc_mean': 0.0, 'rigid_fat_ratio': 0.0}
    for kind in ['rigid', 'fat']:
        Nc_list = []
        for w in ws:
            Nc = hs[-1] + 1
            for h in hs:
                data = family(kind, w, seed + w * 1000 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.max(np.abs(pred - yv))
                if err <= 1e-3:
                    Nc = h
                    break
            Nc_list.append(Nc)
        summary[kind + '_Nc'] = Nc_list
        valid = [n for n in Nc_list if n <= hs[-1]]
        mean_val = float(np.mean(valid)) if valid else float(hs[-1] + 1)
        objectives[kind + '_Nc_mean'] = mean_val
    r0, f0 = summary['rigid_Nc'][0], summary['fat_Nc'][0]
    objectives['rigid_fat_ratio'] = r0 / f0 if f0 > 0 else 1.0
    return {'success': True, 'summary': summary, 'objectives': objectives}
