import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, 2.0, -1.0, 0.5, -0.2, 0.1])[:6]
        y = poly_basis(X, 6) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 6) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 10) @ coeffs)
    y /= scale; yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    from scipy.optimize import minimize
    class Model:
        def __init__(self, X, y, h, seed):
            rng = np.random.default_rng(seed)
            self.W1 = rng.standard_normal((X.shape[1], h)) / np.sqrt(X.shape[1])
            self.b1 = rng.standard_normal(h) * 0.1
            self.W2 = rng.standard_normal((h, 1)) / np.sqrt(h)
            self.b2 = np.zeros((1,))
        def forward(self, X):
            z = np.tanh(X @ self.W1 + self.b1)
            return z @ self.W2 + self.b2
        def loss(self, X, y):
            return np.mean((self.forward(X) - y) ** 2)
        def flatten(self):
            return np.concatenate([self.W1.ravel(), self.b1, self.W2.ravel(), self.b2])
        def unflatten(self, vec):
            n1 = self.W1.size
            self.W1 = vec[:n1].reshape(self.W1.shape)
            self.b1 = vec[n1:n1+len(self.b1)]
            n2 = self.W2.size
            self.W2 = vec[n1+len(self.b1):n1+len(self.b1)+n2].reshape(self.W2.shape)
            self.b2 = vec[n1+len(self.b1)+n2:]
    models = [Model(X, y, h, s) for s in range(seeds)]
    best = None
    best_loss = np.inf
    for m in models:
        res = minimize(lambda v: m.loss(X, y), m.flatten(), method='L-BFGS-B',
                       options={'maxiter': 5000, 'ftol': 1e-12
