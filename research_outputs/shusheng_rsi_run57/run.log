import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 100), 10) @ coeffs)
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}


def run(cfg):
    seed = int(cfg.get('seed', 0))
    wh_list = [(w, h) for w in [4, 8, 16, 32] for h in [4, 8, 16, 32, 64, 128]]
    summary = {'rigid_Nc': [], 'fat_Nc': [], 'scores': []}
    for kind in ['rigid', 'fat']:
        Nc = None
        for w in [4, 8, 16, 32]:
            for h in [4, 8, 16, 32, 64, 128]:
                data = family(kind, w, seed + w*100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                yp = mlp_predict(model, Xv)
                err = np.max(np.abs(yp - yv))
                if err <= 1e-3 and Nc is None:
                    Nc = h
            if Nc is None:
                Nc = 128
            summary[f'{kind}_Nc'].append(Nc)
            summary['scores'].append(float(Nc / 128.0))
    avg_score = np.mean(summary['scores'])
    return {'success': True, 'summary': summary,
            'objectives': {'score': float(avg_score)}}
