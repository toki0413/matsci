import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = rng.uniform(0.05, 0.95, w).reshape(-1, 1)
    Xv = rng.uniform(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        X_poly = poly_basis(X, 3)
        y = X_poly @ coeffs.reshape(-1, 1)
        Xv_poly = poly_basis(Xv, 3)
        yv = Xv_poly @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        X_poly = poly_basis(X, 10)
        y = X_poly @ coeffs.reshape(-1, 1)
        Xv_poly = poly_basis(Xv, 10)
        yv = Xv_poly @ coeffs.reshape(-1, 1)
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    w_list = [10, 20, 50, 100]
    h_list = [4, 8, 16, 32, 64, 128]
    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': [], 'fat_errors': []}
    objectives = {'score': 0.0}
    scale = 1.0
    for w in w_list:
        for kind in ['rigid', 'fat']:
            Nc = None
            min_err = float('inf')
            for h in h_list:
                X, y, Xv, yv = family(kind, w, seed + w * 100 + h)
                if kind == 'rigid' and scale == 1.0:
                    scale = np.std(np.concatenate([y.flatten(), yv.flatten()]))
                y /= scale; yv /= scale
                model = mlp_fit(X, y, h, seeds=3)
                yp = mlp_predict(model, Xv)
                err = float(np.max(np.abs(yp - yv)))
                if err <= 1e-3 and Nc is None:
                    Nc = h
                min_err = min(min_err, err)
                summary[f'{kind}_errors'].append(err)
            if Nc is None:
                Nc = 128
            summary[f'{kind}_Nc'].append(float(Nc))
            if kind == 'rigid':
                objectives['score'] += float(Nc) / 10.0
    return {'success': True, 'summary': summary, 'objectives': objectives}
