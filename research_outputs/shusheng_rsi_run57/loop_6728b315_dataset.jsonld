    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        # 刚性族：球面嵌入，曲率 κ=1，低维流形（S^1），由少量点唯一确定\n        angles = rng.uniform(0, 2 * np.pi, w)\n        X = np.column_stack([np.cos(angles), np.sin(angles)]).reshape(-1, 1)\n        # 真实函数：投影回单位圆（几何重构目标）\n        y = X.copy()\n        angles_v = np.linspace(0, 2 * np.pi, 200)\n        Xv = np.column_stack([np.cos(angles_v), np.sin(angles_v)]).reshape(-1, 1)\n        yv = Xv.copy()\n    elif kind == 'fat':\n        # 肥族：平面高维流形，κ=0，连续自由度，小样本无法唯一确定\n        X = rng.uniform(-1, 1, (w, 1))\n        y = X ** 3 + 0.1 * rng.standard_normal((w, 1))\n        Xv = rng.uniform(-1, 1, (200, 1))\n        yv = Xv ** 3 + 0.1 * rng.standard_normal((200, 1))\n    else:\n        raise ValueError(\"kind must be 'rigid' or 'fat'\")\n    # 统一尺度归一化（基于训练集全局 std）\n    scale = np.std(np.concatenate([X, y])) if np.std(np.concatenate([X, y])) > 1e-6 else 1.0\n    X /= scale; y /= scale; Xv /= scale; yv /= scale\n    X = X.reshape(-1, 1); y = y.reshape(-1, 1); Xv = Xv.reshape(-1, 1); yv = yv.reshape(-1, 1)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef mlp_fit(X, y, h, seeds=3):\n    from scipy.optimize import minimize\n    def forward(W1, b1, W2, b2, X):\n        a1 = np.tanh(X @ W1.T + b1)\n        return a1 @ W2.T + b2\n    def loss_func(params):\n        W1 = params[:h*2].reshape(h, 2)\n        b1 = params[h*2:h*2+h].reshape(1, h)\n        W2 = params[h*2+h:2*h*2+h].reshape(h, 1)\n        b2 = params[2*h*2+h:].reshape(1, 1)\n        y_pred = forward(W1, b1, W2, b2, X)\n        return np.mean((y - y_pred) ** 2)\n    best_loss, best_params = float('inf'), None\n    for seed in range(seeds):\n        rng = np.random.default_rng(seed)\n        W1 = rng.standard_normal((h, 2)) / np.sqrt(2)\n        b1 = rng.standard_normal((1, h))\n        W2 = rng.standard_normal((h, 1)) / np.sqrt(h)\n        b2 = rng.standard_normal((1, 1))\n        params = np.concatenate([W1.ravel(), b1.ravel(), W2.ravel(), b2.ravel()])\n        res = minimize(loss_func, params, method='L-BFGS-B')\n        if res.fun < best_loss:\n            best_loss, best_params = res.fun, res.x\n    W1 = best_params[:h*2].reshape(h, 2)\n    b1 = best_params[h*2:h*2+h].reshape(1, h)\n    W2 = best_params[h*2+h:2*h*2+h].reshape(h, 1)\n    b2 = best_params[2*h*2+h:].reshape(1, 1)\n    return {'W1': W1, 'b1': b1, 'W2': W2, 'b2': b2}\n\ndef mlp_predict(model, X):\n    a1 = np.tanh(X @ model['W1'].T + model['b1'])\n    return a1 @ model['W2'].T + model['b2']\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_vals = [10, 50, 100, 500]\n    h_vals = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': [], 'fat_errors': []}\n    objectives = {'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        err_list = []\n        for w in w_vals:\n            min_Nc = None\n            for h in h_vals:\n                data = family(kind, w, seed + w * 1000 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(yv_pred - yv))\n                err_list.append(err)\n                if err <= 1e-3:\n                    if min_Nc is None or h < min_Nc:\n                        min_Nc = h\n            Nc_list.append(min_Nc if min_Nc is not None else 100)  # 上限保护\n        summary[f'{kind}_Nc'] = Nc_list\n        summary[f'{kind}_errors'] = err_list\n        # 判定刚性：Nc 不随 w 显著增长（≤2倍最小值）\n        nc_arr = np.array([x for x in Nc_list if x != 100])\n        if len(nc_arr) > 0 and np.max(nc_arr) <= 2 * np.min(nc_arr):\n            objectives['score'] += 1.0 if kind == 'rigid' else -1.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
