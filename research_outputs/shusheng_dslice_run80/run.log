import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = rng.uniform(0.05, 0.95, w).reshape(-1, 1)
    Xv = rng.uniform(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(np.concatenate([y, yv]))
    if scale > 1e-10:
        y = y / scale
        yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=1):
    from scipy.optimize import minimize
    import torch
    import torch.nn as nn
    class Model(nn.Module):
        def __init__(self, in_h, out_h):
            super().__init__()
            self.l1 = nn.Linear(in_h, out_h)
            self.l2 = nn.Linear(out_h, 1)
            nn.init.xavier_uniform_(self.l1.weight)
            nn.init.zeros_(self.l1.bias)
            nn.init.xavier_uniform_(self.l2.weight)
            nn.init.zeros_(self.l2.bias)
        def forward(self, x):
            return torch.tanh(self.l1(x)) + self.l2(torch.tanh(self.l1(x)))
    Xt = torch.tensor(X, dtype=torch.float32)
    yt = torch.tensor(y, dtype=torch.float32)
    best_model = None
    best_loss = float('inf')
    for seed in range(seeds):
        torch.manual_seed(seed)
        model = Model(X.shape[1], h)
        optimizer = torch.optim.LBFGS(model.parameters(), lr=1.0)
        for _ in range(50):
            def closure():
                optimizer.zero_grad()
                out = model(Xt)
                loss = ((out - yt) ** 2).mean()
                loss.backward()
                return loss
            optimizer.step(closure)
        with torch.no_grad():
            loss = ((model(Xt) - yt) ** 2).mean().item()
        if loss < best_loss:
            best_loss = loss
