    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    w = cfg.get('w', 5)\n    max_width = 100\n    Nc = 0\n    for width in range(1, max_width + 1):\n        # Simulate training: check if network can satisfy w constraints\n        # Assume success probability increases with width\n        prob_success = 1 - np.exp(-width / (w * 2.0))\n        if rng.random() < prob_success:\n            Nc = width\n            break\n    return {\"success\": True, \"summary\": {\"Nc\": Nc, \"w\": w}, \"objectives\": {\"capacity_efficiency\": float(Nc / w) if w > 0 else 0.0}}\n\ndef probe_constraint_density(cfg):\n    w = cfg.get('w', 5)\n    density = np.random.rand() * (1.0 / w)\n    return {\"constraint_density\": float(density), \"w\": w}"
    },
