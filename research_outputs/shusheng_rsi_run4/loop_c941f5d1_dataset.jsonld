      "value": 1.6666666666666667
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 42))\n    rng = np.random.default_rng(seed)\n    w = cfg.get('w', 10)  # number of constraints\n    max_width = 50       # search range for N_c(w)\n    X = rng.uniform(-1, 1, (w, 1))\n    y = np.sin(np.pi * X).flatten()\n    successes = []\n    for width in range(1, max_width + 1):\n        W1 = rng.normal(0, 1, (1, width))\n        b1 = rng.normal(0, 0.1, (1, width))\n        W2 = rng.normal(0, 1, (width, 1))\n        Z = np.tanh(X * W1 + b1)\n        beta = np.linalg.lstsq(Z, y.reshape(-1, 1), rcond=None)[0].flatten()\n        pred = Z @ beta\n        err = np.mean((pred - y) ** 2)\n        successes.append(err < 1e-5)\n    Nc_w = np.argmax(successes) + 1 if any(successes) else max_width\n    return {\"success\": True,\n            \"summary\": {\"w\": w, \"Nc_w\": int(Nc_w)},\n            \"objectives\": {\"capacity_ratio\": float(w / Nc_w) if Nc_w > 0 else 0.0}}\n\ndef probe_author_probe(cfg):\n    return {\"note\": \"Numerical experiment measures constraint capacity N_c(w) via solvability of small networks under w polynomial-like constraints.\"}"
    },
