import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([0.0, 2 * np.pi, 0.1, 10 * np.pi])
        y = np.sin(coeffs[0] + coeffs[1] * X.flatten()) + np.sin(coeffs[2] + coeffs[3] * X.flatten())
        yv = np.sin(coeffs[0] + coeffs[1] * Xv.flatten()) + np.sin(coeffs[2] + coeffs[3] * Xv.flatten())
    else:
        n_terms = w + 5
        freqs = rng.uniform(1, 20, n_terms)
        amps = rng.exponential(0.5, n_terms)
        phases = rng.uniform(0, 2 * np.pi, n_terms)
        y = np.sum(amps * np.sin(freqs * X.flatten() + phases), axis=0)
        yv = np.sum(amps * np.sin(freqs * Xv.flatten() + phases), axis=0)
    y = y.reshape(-1, 1)
    yv = yv.reshape(-1, 1)
    scale = np.std(np.concatenate((y, yv))) if np.std(np.concatenate((y, yv))) > 1e-10 else 1.0
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    from scipy.optimize import minimize
    rng = np.random.default_rng()
    best_model = None
    best_loss = np.inf
    for seed in range(seeds):
        rng = np.random.default_rng(seed)
        W1 = rng.standard_normal((X.shape[1], h)) / np.sqrt(X.shape[1])
