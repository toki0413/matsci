import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        y = np.sin(np.pi * X)
        yv = np.sin(np.pi * Xv)
    else:
        coeffs = rng.standard_normal(10)
        poly = poly_basis(X, 10) @ coeffs
        yv_poly = poly_basis(Xv, 10) @ coeffs
        y = poly + 0.01 * rng.standard_normal((w, 1))
        yv = yv_poly + 0.01 * rng.standard_normal((200, 1))
    scale = np.std(np.concatenate([y.flatten(), yv.flatten()]))
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [5, 10, 20, 50, 100]
    hs = [2, 4, 8, 16, 32]
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'score': 0.0}
    for kind in ['rigid', 'fat']:
        Nc_list = []
        for w in ws:
            Nc_found = None
            for h in hs:
                data = family(kind, w, seed + w * 1000 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                yv_pred = mlp_predict(model, Xv)
                err = np.max(np.abs(yv_pred - yv))
                if zero_violation(err):
                    Nc_found = h
                    break
            Nc_list.append(Nc_found if Nc_found is not None else float('inf'))
        summary[f'{kind}_Nc'] = Nc_list
        if kind == 'rigid':
            plateau = all(Nc_found is not None for Nc_found in Nc_list[2:])
            if plateau:
                objectives['score'] += 1.0
    return {'success': True, 'summary': summary, 'objectives': objectives}
