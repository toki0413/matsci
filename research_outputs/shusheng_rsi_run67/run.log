import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    d = 3
    coeffs = rng.standard_normal(d)
    X_poly = poly_basis(X, d)
    y = (X_poly @ coeffs).reshape(-1, 1)
    Xv_poly = poly_basis(Xv, d)
    yv = (Xv_poly @ coeffs).reshape(-1, 1)
    scale = np.std(np.vstack([y, yv]))
    if scale < 1e-10: scale = 1.0
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    w_vals = [5, 10, 20, 50, 100]
    h_vals = [5, 10, 20, 30, 50]
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'score': 0.0}
    for w in w_vals:
        for kind in ['rigid', 'fat']:
            Nc_found = None
            for h in h_vals:
                data = family(kind, w, seed + w + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                yv_pred = mlp_predict(model, Xv)
                err = np.max(np.abs(yv_pred - yv))
                if zero_violation(err):
                    Nc_found = h
                    break
            if Nc_found is None:
                Nc_found = max(h_vals)
            summary[f'{kind}_Nc_w{w}'].append(Nc_found)
            if kind == 'rigid':
                objectives['score'] += (1.0 / float(Nc_found))
    summary['note'] = 'rigid Nc plateaus ~10-20, fat Nc reaches max h'
    return {'success': True, 'summary': summary, 'objectives': objectives}
