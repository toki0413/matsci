      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(10)\n        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [5, 10, 20, 50]\n    hs = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        for w in ws:\n            Nc_found = None\n            for h in hs:\n                data = family(kind, w, seed + w * 10 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                scale = np.std(yv)\n                if scale < 1e-10:\n                    scale = 1.0\n                y_norm = y / scale\n                yv_norm = yv / scale\n                model = mlp_fit(X, y_norm, h, seeds=3)\n                yp = mlp_predict(model, Xv)\n                err = np.max(np.abs(yp - yv_norm) * scale)\n                if zero_violation(err):\n                    Nc_found = h\n                    break\n            Nc_list.append(Nc_found if Nc_found is not None else -1)\n        summary[f'{kind}_Nc'].append(Nc_list)\n        if kind == 'rigid':\n            first_valid = next((n for n in Nc_list if n > -1), -1)\n            if first_valid > -1:\n                objectives['score'] += 1.0 / (first_valid + 1)\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
