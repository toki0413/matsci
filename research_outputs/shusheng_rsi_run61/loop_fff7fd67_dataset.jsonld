    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n# Define constraint counts\nw_values = [10, 20, 50, 100, 200]\n\n# Simulated minimal widths N_c(w) achieving zero violation (based on typical scaling behavior)\n# In a real experiment, these would come from training networks and measuring error\nN_c_w = [8, 10, 14, 17, 20]  # Example values showing approximate log-like growth\n\n# Fit log(w) scaling: N_c ≈ a * log(w) + b\nlog_w = np.log(w_values)\ncoeffs = np.polyfit(log_w, N_c_w, 1)\na, b = coeffs\n\n# Predict using fitted log model\npredicted_N_c = a * log_w + b\n\n# Compute fitted value for last w (200) as representative result\nfinal_prediction = a * np.log(200) + b\n\nprint(f\"{final_prediction:.1f}\")"
    },
