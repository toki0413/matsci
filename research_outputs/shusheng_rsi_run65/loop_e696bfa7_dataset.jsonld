    {
      "@type": "PropertyValue",
      "name": "objectives.score",
      "value": 0.0
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 100).reshape(-1, 1)\n    y = np.sin(2 * np.pi * X) + 0.5 * np.cos(4 * np.pi * X)\n    yv = np.sin(2 * np.pi * Xv) + 0.5 * np.cos(4 * np.pi * Xv)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [10, 20, 30, 40, 50]\n    hs = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'score': 0.0}\n    for w in ws:\n        for kind in ['rigid', 'fat']:\n            Nc = None\n            for h in hs:\n                X = family(kind, w, seed)['X']\n                y = family(kind, w, seed)['y']\n                Xv = family(kind, w, seed)['Xv']\n                yv = family(kind, w, seed)['yv']\n                scale = np.std(np.concatenate([X.flatten(), Xv.flatten()]))\n                X = X / scale\n                Xv = Xv / scale\n                y = y / scale\n                yv = yv / scale\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(yv_pred - yv))\n                if err <= 1e-3:\n                    Nc = h\n                    break\n            if Nc is None:\n                Nc = 999\n            summary[f'{kind}_Nc'].append(Nc)\n            if kind == 'rigid' and Nc < 999:\n                objectives['score'] += 1.0 / Nc\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
