import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.5, 1.5])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 10) @ coeffs)
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    w_list = [5, 10, 15, 20]
    h_list = [4, 8, 16, 32]
    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': [], 'fat_errors': []}
    objectives = {'score': 0.0}
    for kind in ['rigid', 'fat']:
        for w in w_list:
            Nc = None
            errs = []
            for h in h_list:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                y_pred = mlp_predict(model, Xv)
                err = np.max(np.abs(y_pred - yv))
                errs.append(float(err))
                if err <= 1e-3 and Nc is None:
                    Nc = h
            if Nc is None:
                Nc = int(max(h_list) + 1)
            summary[f'{kind}_Nc'].append(int(Nc))
            summary[f'{kind}_errors'].append(errs)
            if kind == 'rigid':
                objectives['score'] += 1.0 / (Nc + 1)
            else:
                objectives['score'] -= 1.0 / (Nc + 1)
    summary['note'] = f'rigid_Nc={summary["rigid_Nc"]}, fat_Nc={summary["fat_Nc"]}'
    return {'success': True, 'summary': summary, 'objectives': objectives}
