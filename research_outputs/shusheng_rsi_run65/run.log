import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = rng.uniform(0.05, 0.95, w).reshape(-1, 1)
    Xv = rng.uniform(0.02, 0.98, 200).reshape(-1, 1)
    y = np.sin(2 * np.pi * X)
    yv = np.sin(2 * np.pi * Xv)
    scale = np.std(np.sin(2 * np.pi * np.linspace(0, 1, 1000)))
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    from scipy.optimize import minimize
    import numpy as np
    n_in, n_out = X.shape[1], y.shape[1]
    def init_weights(n_in, h, n_out, seed):
        rng = np.random.default_rng(seed)
        W1 = rng.standard_normal((n_in, h)) / np.sqrt(n_in)
        b1 = np.zeros(h)
        W2 = rng.standard_normal((h, n_out)) / np.sqrt(h)
        b2 = np.zeros(n_out)
        return (W1, b1, W2, b2)
    def forward(X, W1, b1, W2, b2):
        return (W2 @ np.tanh(W1 @ X + b1.reshape(-1,1)) + b2.reshape(-1,1)).flatten()
    def loss(params, X, y):
        W1, b1, W2, b2 = params
        pred = forward(X, W1, b1, W2, b2)
        return np.mean((pred - y)**2)
    best_res = None
    for seed in range(seeds):
        params = init_weights(n_in, h, n_out, seed)
        res = minimize(loss, params, args=(X.flatten(), y.flatten()), method='L-BFGS-B')
        if best_res is None or res.fun < best_res.fun:
            best_res = res
    return best_res, best_res.x

def mlp_predict(model, X):
    W1, b1, W2, b2 = model
    return (W2 @ np.tanh(W1 @ X + b1.reshape(-1,1)) + b2.reshape(-1,1)).flatten()

