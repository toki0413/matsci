import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        y = np.sign(X - 0.5)
        yv = np.sign(Xv - 0.5)
    elif kind == 'fat':
        coeffs = rng.standard_normal(10)
        X_poly = poly_basis(X, 10)
        y = X_poly @ coeffs
        Xv_poly = poly_basis(Xv, 10)
        yv = Xv_poly @ coeffs
    else:
        y = np.zeros((w, 1))
        yv = np.zeros((200, 1))
    scale = np.std(np.vstack([y, yv]))
    if scale > 1e-10:
        y = y / scale
        yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

