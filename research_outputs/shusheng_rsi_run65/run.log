import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = rng.standard_normal(5)
        Xb = poly_basis(X, 5)
        y = Xb @ coeffs.reshape(-1, 1)
        Xvb = poly_basis(Xv, 5)
        yv = Xvb @ coeffs.reshape(-1, 1)
    elif kind == 'fat':
        M = 10
        f_min, f_max = 1.0, 10.0
        freqs = rng.uniform(f_min, f_max, M)
        phases = rng.uniform(0, 2 * np.pi, M)
        coeffs = rng.standard_normal(M)
        term1 = 2 * np.pi * freqs[:, None] * X
        y = np.sum(coeffs[:, None] * np.sin(term1 + phases[:, None]), axis=0)
        term2 = 2 * np.pi * freqs[:, None] * Xv
        yv = np.sum(coeffs[:, None] * np.sin(term2 + phases[:, None]), axis=0)
    else:
        y = np.zeros((w, 1))
        yv = np.zeros((200, 1))
    X_dense = np.linspace(0, 1, 1000).reshape(-1, 1)
    if kind == 'rigid':
        Xbd = poly_basis(X_dense, 5)
        y_dense = Xbd @ coeffs.reshape(-1, 1)
    else:
        termd = 2 * np.pi * freqs[:, None] * X_dense
        y_dense = np.sum(coeffs[:, None] * np.sin(termd + phases[:, None]), axis=0)
    scale = np.std(y_dense)
    if scale < 1e-10: scale = 1.0
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    return {'h': h}

def mlp_predict(model, X):
    return np.zeros((X.shape[0], 1))

def poly_basis(X, n):
    return X ** np.arange(n)

def _as_2d(x):
    return x.reshape(-1, 1)

