import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, 2.0])
        y = poly_basis(X, 2) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 2) @ coeffs.reshape(-1, 1)
    else:
        n_coeffs = w
        coeffs = rng.standard_normal(n_coeffs)
        y = poly_basis(X, n_coeffs) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, n_coeffs) @ coeffs.reshape(-1, 1)
    scale = np.std(np.concatenate([y.flatten(), yv.flatten()])) or 1.0
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}


def run(cfg):
    seed = int(cfg.get('seed', 0))
    w_list = [5, 10, 20, 40]
    h_list = [4, 8, 16, 32]
    max_abs_err = 1e-3
    summary = {'note': '', 'data': []}
    objectives = {'score': 0.0, 'rigid_Nc': [], 'fat_Nc': []}
    kind_list = ['rigid', 'fat']
    
    for kind in kind_list:
        Nc_w = {}
        for w in w_list:
            Nc_for_w = None
            for h in h_list:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                yv_pred = mlp_predict(model, Xv)
                err = float(np.max(np.abs(yv_pred - yv)))
                summary['data'].append({'kind': kind, 'w': w, 'h': h, 'err': err})
                if err <= max_abs_err:
                    if Nc_for_w is None or h < Nc_for_w:
                        Nc_for_w = h
            Nc_w[w] = Nc_for_w if Nc_for_w is not None else 1000.0
        Nc_values = [Nc_w[w] for w in w_list]
        Nc_min = min(Nc_values)
        if kind == 'rigid':
            objectives['rigid_Nc'].append(Nc_min)
            summary['note'] += f"rigid w={w_list} -> N_c={Nc_min} "
            if Nc_min <= 16:
                objectives['score'] += 1.0
        
