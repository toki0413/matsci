                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                yp = mlp_predict(model, Xv)
                err = np.max(np.abs(yp - yv))
                err_w = err
                if err <= 1e-3:
                    Nc_found = h
                    break
            Nc_list.append(Nc_found)
            err_list.append(err_w)
        summary[f'{kind}_Nc'] = Nc_list
        summary[f'{kind}_errors'] = err_list
    rigid_Nc = summary['rigid_Nc']
    fat_Nc = summary['fat_Nc']
