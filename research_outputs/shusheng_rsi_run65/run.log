import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 10) @ coeffs.reshape(-1, 1))
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def poly_basis(X, n):
    X = X.flatten()
    return np.array([X**i for i in range(n)]).T

def _as_2d(x):
    return x.reshape(-1, 1) if x.ndim == 1 else x

def mlp_fit(X, y, h, seeds=3):
    import torch
    import torch.nn as nn
    import torch.optim as optim
    X_ = X.flatten().numpy()
    y_ = y.flatten().numpy()
    class Model(nn.Module):
        def __init__(self):
            super().__init__()
            self.l1 = nn.Linear(1, h)
            self.l2 = nn.Linear(h, 1)
        def forward(self, x):
            return torch.tanh(self.l1(torch.tanh(self.l1(x)))).squeeze()
    best = None
    best_err = float('inf')
    for seed in range(seeds):
        torch.manual_seed(seed + 12345)
        model = Model()
        criterion = nn.MSELoss()
        optimizer = optim.LBFGS(model.parameters(), lr=1.0)
        for step in range(500):
            def closure():
                optimizer.zero_grad()
                out = model(torch.tensor(X_, dtype=torch.float32).view(-1, 1))
                loss = criterion(out, torch.tensor(y_, dtype=torch.float32).view(-1, 1))
                loss.backward()
                return loss
            optimizer.step(closure)
