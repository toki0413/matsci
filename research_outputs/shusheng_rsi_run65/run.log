        torch.manual_seed(s + 1234)
        model = Model()
        loss_fn = nn.MSELoss()
        opt = optim.LBFGS(model.parameters(), lr=0.1)
        for _ in range(500):
            def closure():
                opt.zero_grad()
                y_hat = model(X_t)
                loss = loss_fn(y_hat, y_t)
                loss.backward()
                return loss
            opt.step(closure)
        with torch.no_grad():
