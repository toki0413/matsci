        def forward(self, x):
            return torch.tanh(self.l1(x))
    X_t = torch.FloatTensor(X)
    y_t = torch.FloatTensor(y)
    best = None
    best_loss = 1e10
    for s in range(seeds):
        torch.manual_seed(s + 1234)
        model = Model()
        loss_fn = nn.MSELoss()
        opt = optim.LBFGS(model.parameters(), lr=0.1)
        for _ in range(500):
            def closure():
                opt.zero_grad()
                y_hat = model(X_t)
                loss = loss_fn(y_hat, y_t)
                loss.backward()
                return loss
            opt.step(closure)
        with torch.no_grad():
            loss = loss_fn(model(X_t), y_t).item()
        if loss < best_loss:
            best_loss = loss
            best = (model.state_dict(), h)
    return {'w': X.shape[0], 'h': h, 'params': best[0]}

