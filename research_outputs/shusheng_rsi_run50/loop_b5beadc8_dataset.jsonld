    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        n_coef = 10\n        coeffs = rng.standard_normal(n_coef)\n        y = poly_basis(X, n_coef) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, n_coef) @ coeffs.reshape(-1, 1)\n    scale = np.std(poly_basis(np.linspace(0, 1, 1000), n_coef if kind == 'fat' else 3) @ (coeffs if kind == 'fat' else np.array([1.0, -2.0, 1.0]).reshape(-1, 1)))\n    scale = max(scale, 1.0)\n    y = y / scale\n    yv = yv / scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef poly_basis(X, n):\n    return np.hstack([X**i for i in range(n)])\n\ndef _as_2d(x):\n    return x.reshape(-1, 1) if x.ndim == 1 else x\n\ndef mlp_fit(X, y, h, seeds=3):\n    from scipy.optimize import minimize\n    import torch\n    import torch.nn as nn\n    class Model(nn.Module):\n        def __init__(self, in_h, out_h):\n            super().__init__()\n            self.l1 = nn.Linear(in_h, out_h)\n            self.l2 = nn.Linear(out_h, 1)\n            self.tanh = nn.Tanh()\n        def forward(self, x):\n            x = self.tanh(self.l1(x))\n            return self.l2(x)\n    X_ = X.astype(np.float64)\n    y_ = y.astype(np.float64)\n    best = None\n    best_loss = np.inf\n    for seed in range(seeds):\n        rng = np.random.default_rng(seed)\n        model = Model(1, h)\n        params = list(model.parameters())\n        flat = [p.detach().numpy().flatten() for p in params]\n        def closure():\n            optimizer.zero_grad()\n            x_torch = torch.from_numpy(X_).float()\n            y_torch = torch.from_numpy(y_).float()\n            out = model(x_torch)\n            loss = ((out - y_torch)**2).mean()\n            loss.backward()\n            return loss.item()\n        optimizer = torch.optim.LBFGS(params, lr=0.1)\n        for _ in range(100):\n            optimizer.step(closure)\n        loss = closure()\n        if loss < best_loss:\n            best_loss = loss\n            best = [p.detach().clone() for p in params]\n    return {'params': best, 'loss': best_loss}\n\ndef mlp_predict(model, Xv):\n    import torch\n    Xv_ = Xv.astype(np.float64)\n    with torch.no_grad():\n        x_torch = torch.from_numpy(Xv_).float()\n        model = Model(1, h)\n        for i, p in enumerate(model.parameters()):\n            p.data = torch.from_numpy(model['params'][i])\n        out = model(x_torch)\n        return out.detach().numpy().astype(np.float64)\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_vals = [5, 10, 20, 50]\n    h_vals = [2, 4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_max_err': [], 'fat_max_err': []}\n    objectives = {'rigid_rigid': 0.0, 'fat_fat': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        max_err_list = []\n        for w in w_vals:\n            Nc_found = None\n            for h in h_vals:\n                data = family(kind, w, seed + w * 100 + h)\n                X, y, Xv, yv = data['X'], data['y'], data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(yv_pred - yv))\n                if err <= 1e-3:\n                    if Nc_found is None:\n                        Nc_found = h\n                    break\n            if Nc_found is not None:\n                Nc_list.append(Nc_found)\n                max_err_list.append(err)\n            else:\n                Nc_list.append(h_vals[-1])\n                max_err_list.append(1e-2)\n        summary[f'{kind}_Nc'].append(Nc_list)\n        summary[f'{kind}_max_err'].append(max_err_list)\n        if len(Nc_list) > 0 and all(n == Nc_list[0] for n in Nc_list):\n            objectives[f'{kind}_rigid'] = 1.0\n        else:\n            objectives[f'{kind}_rigid'] = 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
