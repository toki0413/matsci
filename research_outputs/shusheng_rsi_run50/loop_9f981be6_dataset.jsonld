    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(3)\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    scale = np.std(np.concatenate([X.flatten(), Xv.flatten()]))\n    y = y / scale\n    yv = yv / scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [5, 10, 20, 40]\n    hs = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': [], 'fat_errors': []}\n    objectives = {'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        err_list = []\n        for w in ws:\n            Nc_found = None\n            for h in hs:\n                data = family(kind, w, seed + w * 100 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = float(np.max(np.abs(yv_pred - yv)))\n                err_list.append(err)\n                if err <= 1e-3:\n                    if Nc_found is None or h < Nc_found:\n                        Nc_found = float(h)\n            if Nc_found is None:\n                Nc_found = 999.0\n            Nc_list.append(Nc_found)\n            if kind == 'rigid':\n                summary['rigid_errors'].append(err_list[-1])\n            else:\n                summary['fat_errors'].append(err_list[-1])\n        summary[f'{kind}_Nc'].append(Nc_list)\n    avg_rigid_Nc = float(np.mean(summary['rigid_Nc']))\n    avg_fat_Nc = float(np.mean(summary['fat_Nc']))\n    score = 1.0 / (1.0 + avg_rigid_Nc) * (1.0 - 1.0 / (1.0 + avg_fat_Nc))\n    objectives['score'] = float(score)\n    summary['note'] = f'rigid_Nc={summary[\"rigid_Nc\"]}, fat_Nc={summary[\"fat_Nc\"]}'\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
