    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    coeffs = rng.standard_normal(w)\n    Xn = poly_basis(X, w)\n    y = (Xn @ coeffs.reshape(-1, 1)).reshape(-1, 1)\n    Xvn = poly_basis(Xv, w)\n    yv = (Xvn @ coeffs.reshape(-1, 1)).reshape(-1, 1)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [4, 8, 16, 32, 64]\n    Nmax = 64\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'score': 0.0}\n    for w in ws:\n        for kind in ['rigid', 'fat']:\n            Nc = None\n            for h in range(1, Nmax + 1):\n                data = family(kind, w, seed + w * 100 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                yp = mlp_predict(model, Xv)\n                err = np.max(np.abs(yp - yv))\n                if err <= 1e-3:\n                    Nc = h\n                    break\n            if Nc is None:\n                Nc = Nmax + 1\n            summary[f'{kind}_Nc'].append(Nc)\n            objectives[f'{kind}_w{w}'] = float(Nc)\n    objectives['score'] = float(np.mean([summary['rigid_Nc'][i] / ((ws[i] + 1) // 2) for i in range(len(ws))]))\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
