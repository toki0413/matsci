import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        # 刚性族：线性约束 + 唯一解析解 y = 2*x + 1 (2维，低维刚性)
        true_coef = np.array([1.0, 2.0])  # [bias, slope]
        y = poly_basis(X, 2) @ true_coef.reshape(-1, 1)
        yv = poly_basis(Xv, 2) @ true_coef.reshape(-1, 1)
    else:
        # 肥族：高维多项式，系数随机，解空间连续 (50维，高维肥)
        true_coef = rng.standard_normal(50)
        y = poly_basis(X, 50) @ true_coef.reshape(-1, 1)
        yv = poly_basis(Xv, 50) @ true_coef.reshape(-1, 1)
    # 统一尺度：在稠密网格上计算 std，与 w 无关
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 50) @ true_coef)
    if scale == 0:
        scale = 1.0
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}


def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [10, 20, 30, 50, 100, 200, 300, 500, 700, 1000]
    # 隐藏层宽度扫描范围：覆盖预期 N_c(w) ~ 15 + 8*log10(w)
    # log10(10)=1 -> 23; log10(1000)=3 -> 39，取 10 到 50 足够
    hs = list(range(10, 51, 2))
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'rigid_score': 0.0, 'fat_score': 0.0, 'rigid_fits': 0, 'fat_fits': 0}
    for kind in ['rigid', 'fat']:
        Nc_list = []
        for w in ws:
            Nc_found = None
            for h in hs:
                data = family(kind, w, seed + w * 1000 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.max(np.abs(pred - yv))
                if err <= 1e-3:
                    Nc_found = h
                    break
            if Nc_found is None:
                Nc_found = 51  # 扫描上限内未达零违规，记为 51 (超出 hs 最大值 50)
            Nc_list.append(Nc_found)
        summary[f'{kind}_Nc'].append(Nc_list)
        fit_count = sum(1 for v in Nc_list if v < 51)
        
