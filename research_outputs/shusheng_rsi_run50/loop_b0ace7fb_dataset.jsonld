    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        true_func = lambda x: np.sin(2 * np.pi * x)\n        coeffs = np.array([1.0, 0.0])  # 1*sin(2pi x) + 0*cos(2pi x)\n        y = true_func(X)\n        yv = true_func(Xv)\n    else:  # fat\n        coeffs = rng.standard_normal(10)\n        basis = np.hstack([np.cos(2 * np.pi * i * X) for i in range(1, 11)])\n        y = basis @ coeffs.reshape(-1, 1)\n        basis_v = np.hstack([np.cos(2 * np.pi * i * Xv) for i in range(1, 11)])\n        yv = basis_v @ coeffs.reshape(-1, 1)\n    y = y.reshape(-1, 1)\n    yv = yv.reshape(-1, 1)\n    scale = np.std(np.concatenate([y, yv]))\n    if scale < 1e-10: scale = 1.0\n    y /= scale\n    yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef mlp_fit(X, y, h, seeds=3):\n    from scipy.optimize import minimize\n    n_in, n_out = X.shape[1], y.shape[1]\n    def forward(W1, b1, W2, b2, X):\n        return np.tanh(X @ W1 + b1) @ W2 + b2\n    def loss_fn(params):\n        W1 = params[:n_in*h].reshape(n_in, h)\n        b1 = params[n_in*h:n_in*h+h]\n        W2 = params[n_in*h+h:n_in*h+h*h].reshape(h, n_out)\n        b2 = params[n_in*h+h*h:]\n        y_pred = forward(W1, b1, W2, b2, X)\n        return np.mean((y_pred - y)**2)\n    best_loss = float('inf')\n    best_params = None\n    for s in range(seeds):\n        rng = np.random.default_rng(s)\n        W1 = rng.normal(0, 1/np.sqrt(n_in), (n_in, h))\n        b1 = rng.normal(0, 0.1, h)\n        W2 = rng.normal(0, 1/np.sqrt(h), (h, n_out))\n        b2 = rng.normal(0, 0.1, n_out)\n        init_params = np.concatenate([W1.flatten(), b1, W2.flatten(), b2])\n        res = minimize(loss_fn, init_params, method='L-BFGS-B',\n                       options={'maxiter': 500, 'ftol': 1e-12})\n        if res.fun < best_loss:\n            best_loss = res.fun\n            best_params = res.x\n    W1 = best_params[:n_in*h].reshape(n_in, h)\n    b1 = best_params[n_in:h*n_in+h]\n    W2 = best_params[h*n_in:h*n_in+h*n_out].reshape(h, n_out)\n    b2 = best_params[h*n_in+h*n_out:]\n    return {'W1': W1, 'b1': b1, 'W2': W2, 'b2': b2}\n\ndef mlp_predict(model, X):\n    return np.tanh(X @ model['W1'] + model['b1']) @ model['W2'] + model['b2']\n\ndef poly_basis(X, n):\n    N = X.shape[0]\n    X = X.flatten()\n    out = np.ones((N, n))\n    for i in range(1, n):\n        out[:, i] = X ** i\n    return out\n\ndef _as_2d(arr):\n    return arr.reshape(-1, 1) if arr.ndim == 1 else arr\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_vals = [3, 5, 7, 10, 15]\n    h_vals = [1, 2, 3, 4, 5, 6, 8, 10, 12, 15]\n    summary = {'rigid': {}, 'fat': {}}\n    objectives = {}\n    scale_global = 1.0\n    for kind in ['rigid', 'fat']:\n        summary[kind] = {}\n        Nc_list = []\n        for w in w_vals:\n            data = family(kind, w, seed + w * 1000)\n            X, y = data['X'], data['y']\n            Xv, yv = data['Xv'], data['yv']\n            if kind == 'rigid' and w > 1:\n                scale_global = np.std(y) if np.std(y) > 1e-10 else 1.0\n                y /= scale_global\n                yv /= scale_global\n            Nc_found = None\n            for h in h_vals:\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(yv_pred - yv))\n                if err <= 1e-3:\n                    Nc_found = h\n                    break\n            Nc_list.append(Nc_found if Nc_found is not None else 0)\n            summary[kind][w] = {'Nc': Nc_found if Nc_found else 0, 'err': err}\n        objectives[kind + '_Nc_trend'] = sum(Nc_list) / len(Nc_list)\n        if all(nc == 0 for nc in Nc_list):\n            objectives[kind + '_is_fat'] = 1.0\n        else:\n            objectives[kind + '_is_rigid'] = 1.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
