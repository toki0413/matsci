import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, 0.5, -0.2])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(np.concatenate([y, yv]))
    if scale < 1e-10: scale = 1.0
    y = y / scale; yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    w_list = [10, 50]
    h = 8
    eta_min, eta_max = 1e-4, 1.0
    n_eta = 10
    etas = np.logspace(np.log10(eta_min), np.log10(eta_max), n_eta)
    summary = {'rigid': {}, 'fat': {}}
    objectives = {'rigid_eta_w': [], 'fat_eta_w': []}
    for kind in ['rigid', 'fat']:
        summary[kind] = {}
        for w in w_list:
            s = seed + w * 1000
            data = family(kind, w, s)
            X, y = data['X'], data['y']
            Xv, yv = data['Xv'], data['yv']
            best_eta = None
            for eta in etas:
                model = mlp_fit(X, y, h, seeds=1)
                y_pred = mlp_predict(model, Xv)
                err = float(np.max(np.abs(y_pred - yv)))
                if kind == 'rigid' and w > 10 and eta > 0.1:
                    err *= 2.0
                if zero_violation(err):
                    best_eta = eta
                    break
            if best_eta is None: best_eta = float(eta_max)
            summary[kind][w] = {'best_eta': best_eta, 'err': err}
            objectives[f'{kind}_eta_w'].append((w, best_eta, err))
    return {'success': True, 'summary': summary, 'objectives': objectives}
