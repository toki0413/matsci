    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(-0.9, 0.9, w).reshape(-1, 1)\n    Xv = np.linspace(-0.95, 0.95, 200).reshape(-1, 1)\n    d = 5\n    coeffs = rng.standard_normal(d + 1)\n    y = poly_basis(X, d + 1) @ coeffs.reshape(-1, 1)\n    yv = poly_basis(Xv, d + 1) @ coeffs.reshape(-1, 1)\n    scale = np.std(yv)\n    y = y / scale\n    yv = yv / scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef mlp_fit(X, y, h, seeds=3):\n    import torch\n    import torch.nn as nn\n    import torch.optim as optim\n    device = torch.device('cpu')\n    X_t = torch.tensor(X, dtype=torch.float64, device=device)\n    y_t = torch.tensor(y, dtype=torch.float64, device=device)\n    best_err = float('inf')\n    best_model = None\n    for seed in range(seeds):\n        torch.manual_seed(seed)\n        model = nn.Sequential(\n            nn.Linear(1, h),\n            nn.ReLU(),\n            nn.Linear(h, 1)\n        ).to(device)\n        optimizer = optim.Adam(model.parameters(), lr=1e-3)\n        criterion = nn.MSELoss()\n        patience = 0\n        for epoch in range(5000):\n            optimizer.zero_grad()\n            out = model(X_t)\n            loss = criterion(out, y_t)\n            loss.backward()\n            optimizer.step()\n            if epoch % 100 == 0:\n                print(f\"Seed {seed}, Epoch {epoch}, Loss {loss.item():.6f}\")\n        with torch.no_grad():\n            pred = model(X_t)\n            err = torch.max(torch.abs(pred - y_t)).item()\n        if err < best_err:\n            best_err = err\n            best_model = model\n    return best_model\n\ndef mlp_predict(model, X):\n    import torch\n    device = next(model.parameters()).device\n    X_t = torch.tensor(X, dtype=torch.float64, device=device)\n    with torch.no_grad():\n        return model(X_t).cpu().numpy()\n\ndef poly_basis(X, n):\n    X = X.flatten()\n    return np.array([X**i for i in range(n)]).T\n\ndef _as_2d(x):\n    return x.reshape(-1, 1)\n\ndef zero_violation(max_abs_err):\n    return max_abs_err <= 1e-3\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_vals = [10, 20, 30]\n    h_vals = [10, 20, 50, 100]\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'rigid_score': 0.0, 'fat_score': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        for w in w_vals:\n            Nc_found = None\n            for h in h_vals:\n                data = family(kind, w, seed + w * 100 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                pred = mlp_predict(model, Xv)\n                max_abs_err = float(np.max(np.abs(pred - yv)))\n                if zero_violation(max_abs_err):\n                    Nc_found = h\n                    break\n            Nc_list.append(Nc_found if Nc_found is not None else -1)\n        summary[f'{kind}_Nc'] = Nc_list\n        valid_Nc = [n for n in Nc_list if n > 0]\n        if valid_Nc:\n            objectives[f'{kind}_score'] = float(np.mean(valid_Nc))\n        else:\n            objectives[f'{kind}_score'] = 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
