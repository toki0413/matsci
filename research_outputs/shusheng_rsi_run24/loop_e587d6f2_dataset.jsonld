    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef family(kind, w, seed):\n    # ===== 定义\"刚(rigid)/肥(fat)\"各自对应的约束族 =====\n    # kind: 'rigid' 或 'fat'; w: 训练约束点数; seed: 随机种子\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        # 刚性：低维唯一解，线性函数 y = 2*x + 1，解析解唯一\n        X = np.linspace(0.0, 1.0, w).reshape(-1, 1)\n        y = 2.0 * X + 1.0\n        Xv = np.linspace(0.0, 1.0, 200).reshape(-1, 1)\n        yv = 2.0 * Xv + 1.0\n    elif kind == 'fat':\n        # 肥：高维连续族，y = a*x + b，a,b 连续变化，无穷多解\n        # 固定 w 个点，但允许多组 (a,b) 满足，构造时用随机扰动生成多解族\n        X = np.linspace(0.0, 1.0, w).reshape(-1, 1)\n        # 构造一组基础解：y = x，然后加入小扰动保持“在曲线上但非唯一”\n        # 实际约束族是 y = a*x + b，我们采样多个 (a,b) 来生成多个合法 y\n        a = rng.uniform(0.8, 1.2)\n        b = rng.uniform(-0.1, 0.1)\n        y = a * X + b\n        # 留出点也服从同一族，但用于测试泛化到未见约束点\n        Xv = np.linspace(0.0, 1.0, 200).reshape(-1, 1)\n        yv = a * Xv + b\n    else:\n        raise ValueError(f\"unknown kind: {kind}\")\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    return capacity_scan(family, seed=seed)"
    },
