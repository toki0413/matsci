    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(10)\n        Xw = np.sort(rng.uniform(0.0, 1.0, w)).reshape(-1, 1)\n        yw = poly_basis(Xw, 10) @ coeffs.reshape(-1, 1)\n        Xv2 = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n        yv2 = poly_basis(Xv2, 10) @ coeffs.reshape(-1, 1)\n        X = Xw\n        y = yw\n        Xv = Xv2\n        yv = yv2\n    scale = np.std(np.concatenate((y, yv)))\n    if scale == 0:\n        scale = 1.0\n    y /= scale\n    yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef poly_basis(X, n):\n    N = X.shape[0]\n    X = X.reshape(-1)\n    return np.array([X**i for i in range(n)]).T\n\ndef _as_2d(x):\n    return x.reshape(-1, 1) if x.ndim == 1 else x\n\ndef mlp_fit(X, y, h, seeds=3):\n    import scipy.optimize as opt\n    n_in, n_out = X.shape[1], y.shape[1]\n    n_mid = h\n    def forward(params):\n        W1 = params[:n_in*n_mid].reshape(n_in, n_mid)\n        b1 = params[n_in*n_mid:n_in*n_mid+n_mid].reshape(1, n_mid)\n        W2 = params[n_in*n_mid+n_mid:n_in*n_mid+n_mid+n_mid*n_out].reshape(n_mid, n_out)\n        b2 = params[n_in*n_mid+n_mid+n_mid*n_out:].reshape(1, n_out)\n        h1 = np.tanh(X @ W1 + b1)\n        return h1 @ W2 + b2\n    def loss_and_grad(params):\n        y_pred = forward(params)\n        loss = np.mean((y_pred - y)**2)\n        grad = opt.approx_fprime(params, lambda p: np.mean((forward(p) - y)**2), 1e-8)\n        return loss, grad\n    best_loss = np.inf\n    best_params = None\n    for seed in range(seeds):\n        rng = np.random.default_rng(seed)\n        init_params = np.concatenate([\n            rng.standard_normal(n_in * n_mid),\n            rng.standard_normal(n_mid),\n            rng.standard_normal(n_mid * n_out),\n            rng.standard_normal(n_out)\n        ])\n        res = opt.minimize(loss_and_grad, init_params, method='L-BFGS-B',\n                           options={'maxiter': 1000, 'ftol': 1e-12})\n        if res.fun < best_loss:\n            best_loss = res.fun\n            best_params = res.x\n    return {'params': best_params, 'n_in': n_in, 'n_mid': n_mid, 'n_out': n_out}\n\ndef mlp_predict(model, X):\n    params = model['params']\n    n_in, n_mid, n_out = model['n_in'], model['n_mid'], model['n_out']\n    W1 = params[:n_in*n_mid].reshape(n_in, n_mid)\n    b1 = params[n_in*n_mid:n_in*n_mid+n_mid].reshape(1, n_mid)\n    W2 = params[n_in*n_mid+n_mid:n_in*n_mid+n_mid+n_mid*n_out].reshape(n_mid, n_out)\n    b2 = params[n_in*n_mid+n_mid+n_mid*n_out:].reshape(1, n_out)\n    h1 = np.tanh(X @ W1 + b1)\n    return h1 @ W2 + b2\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_values = [5, 10, 20, 40]\n    h_values = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': [], 'fat_errors': []}\n    objectives = {'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        err_list = []\n        for w in w_values:\n            best_Nc = 999\n            min_err = 1.0\n            for h in h_values:\n                data = family(kind, w, seed + w * 100 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(yv_pred - yv))\n                if err <= 1e-3 and h < best_Nc:\n                    best_Nc = h\n                    min_err = err\n            if best_Nc < 999:\n                Nc_list.append(float(best_Nc))\n                err_list.append(float(min_err))\n            else:\n                Nc_list.append(float(999))\n                err_list.append(float(min_err))\n        summary[f'{kind}_Nc'].append(Nc_list)\n        summary[f'{kind}_errors'].append(err_list)\n        if kind == 'rigid':\n            objectives['score'] = float(np.mean([n for n in Nc_list if n < 100]))\n        else:\n            objectives['score'] = float(np.mean([n for n in Nc_list if n >= 100]))\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
