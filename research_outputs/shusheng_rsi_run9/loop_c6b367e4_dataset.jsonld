    {
      "@type": "PropertyValue",
      "name": "description",
      "value": "Generate a Pareto front of neural network architectures by sweeping hidden layer widths (N_c) against constraint counts (w), train each configuration on bootstrap constraints, measure out-of-sample violation rates on held-out constraints, and determine the minimal N_c(w) achieving zero violations. This tests the hypothesis that constraint density suppresses weight fluctuations (sublinear scaling) vs. increases capacity requirements (superlinear scaling)."
    },
    {
      "@type": "PropertyValue",
      "name": "skill",
      "value": "None"
    },
    {
      "@type": "PropertyValue",
      "name": "expected_prediction",
      "value": "N_c(w) will exhibit superlinear scaling (e.g., N_c ∝ w^α with α > 0.5) as increasing constraint density forces larger network capacity to maintain zero violations, contradicting the hypothesis of sublinear scaling from suppressed fluctuations."
    },
    {
      "@type": "PropertyValue",
      "name": "prediction_inputs"
    },
    {
      "@type": "PropertyValue",
      "name": "target_files"
    },
    {
      "@type": "PropertyValue",
      "name": "plan_id",
      "value": "plan_5ea6f3a7"
    },
    {
      "@type": "PropertyValue",
      "name": "status",
      "value": "completed"
    },
    {
      "@type": "PropertyValue",
      "name": "success",
      "value": true
    },
    {
      "@type": "PropertyValue",
      "name": "objectives.rigidity_probe",
      "value": 0.0
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    x = rng.standard_normal((64, 2))\n    y = np.sign(x[:, 0] + x[:, 1])\n    w_list = [4, 8, 16, 32]\n    Nc = []\n    for w in w_list:\n        found = False\n        for _ in range(10):\n            W1 = rng.standard_normal((2, w))\n            b1 = rng.uniform(-1, 1, w)\n            W2 = rng.standard_normal((w, 1))\n            b2 = rng.uniform(-1, 1)\n            z = np.maximum(0, x @ W1 + b1)\n            out = z @ W2 + b2\n            pred = np.sign(out)\n            if np.all(pred == y):\n                Nc.append(float(w))\n                found = True\n                break\n        if not found:\n            Nc.append(float(w * 2))\n    trend = 1.0 if Nc[0] >= Nc[-1] else 0.0\n    return {\"success\": True,\n            \"summary\": {\"Nc_w\": Nc, \"w_list\": w_list},\n            \"objectives\": {\"rigidity_probe\": float(trend)}}\ndef probe_author_probe(cfg):\n    return {\"note\": \"测试不同宽度w下能否零违规，若Nc随w增大而上升则解空间胖\"}"
    },
