    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    # 10D ambient, 2D manifold (circle)\n    t = rng.uniform(0, 2 * np.pi, w)\n    # Embed circle in 10D: (cos t, sin t, 0, ..., 0)\n    X = np.zeros((w, 10))\n    X[:, 0] = np.cos(t)\n    X[:, 1] = np.sin(t)\n    # Target: constant on manifold (e.g., distance to origin squared = 1)\n    y = np.ones((w, 1)) \n    #留出集: 不同采样点，确保不重合\n    tv = rng.uniform(0, 2 * np.pi, 200)\n    Xv = np.zeros((200, 10))\n    Xv[:, 0] = np.cos(tv)\n    Xv[:, 1] = np.sin(tv)\n    yv = np.ones((200, 1))\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [4, 8, 16, 32, 64]\n    hs = range(4, 21)\n    summary = {'rigid': {}, 'fat': {}}\n    objectives = {}\n    for kind in ('rigid', 'fat'):\n        summary[kind] = {}\n        nc_list = []\n        for w in ws:\n            found = False\n            for h in hs:\n                data = family(kind, w, seed + w * 1000 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                scale = np.std(np.vstack((y, yv)))\n                if scale > 0:\n                    y = y / scale\n                    yv = yv / scale\n                model = mlp_fit(X, y, h, seeds=3)\n                yp = mlp_predict(model, Xv)\n                err = np.max(np.abs(yp - yv))\n                if zero_violation(err):\n                    nc_list.append(h)\n                    found = True\n                    break\n            if found:\n                summary[kind][w] = min(nc_list)\n            else:\n                summary[kind][w] = 999\n        nc_mean = np.mean([summary[kind][w] for w in ws if summary[kind][w] < 999])\n        objectives[f'nc_{kind}'] = float(nc_mean) if np.isfinite(nc_mean) else 999.0\n        objectives[f'rigid_{kind}'] = 1.0 if all(summary[kind][w] < 999 for w in ws) else 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
