      "@type": "PropertyValue",
      "name": "objectives.score",
      "value": 0.11111111111111112
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    w_list = [5, 10, 20, 40, 80]\n    Nc_list = []\n    for w in w_list:\n        X_train = rng.uniform(-1, 1, (w, 2))\n        y_train = np.sign(X_train[:, 0] + X_train[:, 1])\n        X_val = rng.uniform(-1, 1, (10, 2))\n        y_val = np.sign(X_val[:, 0] + X_val[:, 1])\n        Nc = 1\n        while Nc <= 128:\n            W1 = rng.normal(0, 1, (2, Nc))\n            b1 = rng.normal(0, 1, (Nc,))\n            W2 = rng.normal(0, 1, (Nc, 1))\n            Z = np.tanh(X_train @ W1 + b1)\n            y_pred = (Z @ W2 > 0).astype(float).flatten()\n            if np.all(y_pred == y_train):\n                Zv = np.tanh(X_val @ W1 + b1)\n                ypv = (Zv @ W2 > 0).astype(float).flatten()\n                if np.all(ypv == y_val):\n                    break\n            Nc *= 2\n        Nc_list.append(Nc)\n    trend = \"decreasing\" if all(Nc_list[i] >= Nc_list[i+1] for i in range(len(Nc_list)-1)) else \"increasing\"\n    return {\"success\": True, \"summary\": {\"w_list\": w_list, \"Nc_list\": Nc_list, \"trend\": trend}, \"objectives\": {\"score\": float(np.mean([1.0/(np.log2(Nc)+1) for Nc in Nc_list]))}}\n\ndef probe_author_probe(cfg):\n    return {\"note\": \"Nc(w)趋势反映解空间刚性：下降→刚性，上升→胖\"}"
    },
