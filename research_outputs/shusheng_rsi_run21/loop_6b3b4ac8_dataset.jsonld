    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        X = np.linspace(-1.0, 1.0, w).reshape(-1, 1)\n        y = X ** 2\n        Xv = np.linspace(-1.0, 1.0, 200).reshape(-1, 1)\n        yv = Xv ** 2\n    elif kind == 'fat':\n        X = rng.uniform(-1.0, 1.0, (w, 1)).reshape(-1, 1)\n        y = rng.standard_normal((w, 1))\n        Xv = rng.uniform(-1.0, 1.0, (200, 1)).reshape(-1, 1)\n        yv = rng.standard_normal((200, 1))\n    else:\n        X = np.linspace(0.0, 1.0, w).reshape(-1, 1)\n        y = np.sin(np.pi * X)\n        Xv = np.linspace(0.0, 1.0, 200).reshape(-1, 1)\n        yv = np.sin(np.pi * Xv)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    return capacity_scan(family, seed=seed)"
    },
