    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef poly_basis(X, n):\n    return np.hstack([X**i for i in range(n)])\n\ndef _as_2d(x):\n    return x.reshape(-1, 1) if x.ndim == 1 else x\n\ndef mlp_fit(X, y, h, seeds=1):\n    import torch\n    import torch.nn as nn\n    import torch.optim as optim\n    from torch.utils.data import TensorDataset, DataLoader\n    X_t = torch.tensor(X, dtype=torch.float32)\n    y_t = torch.tensor(y, dtype=torch.float32)\n    best_model = None\n    best_loss = float('inf')\n    for seed in range(seeds):\n        torch.manual_seed(seed)\n        model = nn.Sequential(nn.Linear(1, h), nn.Tanh(), nn.Linear(h, 1))\n        criterion = nn.MSELoss()\n        optimizer = optim.LBFGS(model.parameters(), lr=1.0)\n        loader = DataLoader(TensorDataset(X_t, y_t), batch_size=min(32, len(X)), shuffle=True)\n        for _ in range(200):\n            def closure():\n                optimizer.zero_grad()\n                out = model(X_t)\n                loss = criterion(out, y_t)\n                loss.backward()\n                return loss\n            optimizer.step(closure)\n        with torch.no_grad():\n            loss = criterion(model(X_t), y_t).item()\n        if loss < best_loss:\n            best_loss = loss\n            best_model = model\n    return best_model\n\ndef mlp_predict(model, X):\n    import torch\n    with torch.no_grad():\n        return model(torch.tensor(X, dtype=torch.float32)).numpy()\n\ndef zero_violation(err):\n    return float(np.max(np.abs(err))) <= 1e-3\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = rng.uniform(0.1, 0.9, w).reshape(-1, 1)\n    Xv = rng.uniform(0.1, 0.9, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -3.0, 2.0])\n        y = (X**2 * coeffs[2] + X * coeffs[1] + coeffs[0]).reshape(-1, 1)\n        yv = (Xv**2 * coeffs[2] + Xv * coeffs[1] + coeffs[0]).reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(10)\n        Xb = poly_basis(X, 10)\n        Xvb = poly_basis(Xv, 10)\n        y = (Xb @ coeffs.reshape(-1, 1))\n        yv = (Xvb @ coeffs.reshape(-1, 1))\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_list = [3, 5]\n    h_list = [4, 8, 16]\n    summary = {'rigid': {}, 'fat': {}}\n    objectives = {'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        summary[kind] = {}\n        for w in w_list:\n            summary[kind][w] = {'N_c': None}\n            for h in h_list:\n                data = family(kind, w, seed + w + h)\n                X = data['X']\n                y = data['y']\n                Xv = data['Xv']\n                yv = data['yv']\n                scale = np.std(y)\n                if scale < 1e-10:\n                    scale = 1.0\n                y_norm = y / scale\n                yv_norm = yv / scale\n                X_norm = X / scale\n                Xv_norm = Xv / scale\n                model = mlp_fit(X_norm, y_norm, h, seeds=1)\n                yv_pred = mlp_predict(model, Xv_norm)\n                err = (yv_pred - yv_norm).flatten()\n                if zero_violation(err):\n                    if summary[kind][w]['N_c'] is None or h < summary[kind][w]['N_c']:\n                        summary[kind][w]['N_c'] = h\n                        summary[kind][w]['max_err'] = float(np.max(np.abs(err)))\n                        summary[kind][w]['scale'] = float(scale)\n                    break\n            if summary[kind][w]['N_c'] is None:\n                summary[kind][w]['N_c'] = 999\n                summary[kind][w]['max_err'] = 1.0\n                summary[kind][w]['scale'] = 1.0\n        if kind == 'rigid' and all(summary[kind][w]['N_c'] <= 16 for w in w_list):\n            objectives['score'] += 1.0\n        else:\n            objectives['score'] += 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
