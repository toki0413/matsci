    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\nfrom scipy.optimize import minimize\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    N, d_in = 10, 1\n    X = rng.uniform(0.0, 1.0, (N, d_in))\n    y = np.sin(np.pi * X).reshape(-1, 1)\n    Xv = np.linspace(0.0, 1.0, 25).reshape(-1, 1)\n    yv = np.sin(np.pi * Xv).reshape(-1, 1)\n    best_val_err = 1e9\n    train_errs = []\n    val_errs = []\n    widths = []\n    for h in [2, 4, 8, 16]:\n        best_h_err = 1e9\n        best_h_p = None\n        for _ in range(3):\n            p0 = rng.standard_normal(2 * h * (d_in + 1) + h + 1)\n            def loss(p, h=h, d_in=d_in):\n                W1 = p[:h * d_in].reshape(h, d_in)\n                b1 = p[h * d_in:h * d_in + h].reshape(h, 1)\n                W2 = p[h * d_in + h:h * d_in + h + h].reshape(1, h)\n                b2 = p[h * d_in + 2 * h:h * d_in + 2 * h + 1].reshape(1, 1)\n                H = np.tanh(X @ W1.T + b1.T)\n                out = H @ W2.T + b2\n                return float(np.mean((out - y) ** 2))\n            res = minimize(loss, p0, method='L-BFGS-B',\n                           options={'maxiter': 20000})\n            W1 = res.x[:h * d_in].reshape(h, d_in)\n            b1 = res.x[h * d_in:h * d_in + h].reshape(h, 1)\n            W2 = res.x[h * d_in + h:h * d_in + 2 * h].reshape(1, h)\n            b2 = res.x[h * d_in + 2 * h:h * d_in + 2 * h + 1].reshape(1, 1)\n            H = np.tanh(X @ W1.T + b1.T)\n            train_out = H @ W2.T + b2\n            train_err = float(np.mean((train_out - y) ** 2))\n            val_H = np.tanh(Xv @ W1.T + b1.T)\n            val_out = val_H @ W2.T + b2\n            val_err = float(np.max(np.abs(val_out - yv)))\n            if val_err < best_h_err:\n                best_h_err = val_err\n                best_h_p = res.x\n        train_errs.append(train_err)\n        val_errs.append(best_h_err)\n        widths.append(h)\n        if best_h_err < best_val_err:\n            best_val_err = best_h_err\n    return {\"success\": True,\n            \"summary\": {\"widths\": widths, \"train_errs\": train_errs,\n                        \"val_errs\": val_errs, \"best_val_err\": best_val_err},\n            \"objectives\": {\"min_val_err\": -best_val_err}}"
    },
