import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 10) @ coeffs.reshape(-1, 1))
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    w_vals = [4, 8, 16, 32]
    h_vals = [4, 8, 16, 32, 64]
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'rigid_score': 0.0, 'fat_score': 0.0, 'score': 0.0}
    for kind in ['rigid', 'fat']:
        Nc_list = []
        for w in w_vals:
            Nc_found = None
            for h in h_vals:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.max(np.abs(pred - yv))
                if err <= 1e-3:
                    Nc_found = h
                    break
            Nc_list.append(Nc_found if Nc_found is not None else 65)
        if kind == 'rigid':
            summary['rigid_Nc'] = Nc_list
            min_nc = min(Nc_list)
            objectives['rigid_score'] = float(min_nc) / 64.0
        else:
            summary['fat_Nc'] = Nc_list
            if all(nc > 64 for nc in Nc_list):
                objectives['fat_score'] = 1.0
    objectives['score'] = (objectives['rigid_score'] + objectives['fat_score']) / 2.0
    return {'success': True, 'summary': summary, 'objectives': objectives}
