    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    Ca, Si, Al, O = cfg.get('Ca', 0.1), cfg.get('Si', 0.5), cfg.get('Al', 0.1), cfg.get('O', 0.3)\n    total = Ca + Si + Al + O\n    Ca, Si, Al, O = Ca/total, Si/total, Al/total, O/total\n    n_sites = 10000\n    lattice = np.zeros(n_sites, dtype=bool)\n    for i in range(n_sites):\n        if rng.random() < Ca: lattice[i] = True\n        if rng.random() < Si: lattice[i] = True\n        if rng.random() < Al: lattice[i] = True\n    voids = np.sum(~lattice)\n    void_frac = voids / n_sites\n    connectivity = np.sum(lattice[:-1] & lattice[1:]) / (n_sites - 1)\n    activation_energy = 0.5 * (1 - void_frac) * (1 - connectivity)\n    percolation = void_frac < 0.3 and connectivity > 0.6\n    return {\"success\": True,\n            \"summary\": {\"void_density\": void_frac, \"connectivity\": connectivity, \"percolation\": percolation},\n            \"objectives\": {\"migration_barrier\": float(activation_energy), \"percolation_success\": float(percolation)}}\ndef probe_author_probe(cfg):\n    return {\"note\": \"Probe for composition-dependent percolation threshold validation\"}"
    },
    {
