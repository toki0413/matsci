    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        x_train = rng.uniform(-1.0, 1.0, w).reshape(-1, 1)\n        y_train = x_train ** 2\n        x_val = np.linspace(-1.0, 1.0, 200).reshape(-1, 1)\n        y_val = x_val ** 2\n    elif kind == 'fat':\n        coeffs = rng.standard_normal((20, 1))\n        x_train = rng.uniform(-1.0, 1.0, w).reshape(-1, 1)\n        y_train = np.zeros_like(x_train)\n        for i in range(20):\n            y_train += coeffs[i] * (2 * x_train - 1) ** i\n        x_val = np.linspace(-1.0, 1.0, 200).reshape(-1, 1)\n        y_val = np.zeros_like(x_val)\n        for i in range(20):\n            y_val += coeffs[i] * (2 * x_val - 1) ** i\n    else:\n        raise ValueError(f\"Unknown kind: {kind}\")\n    scale = np.std(np.concatenate([y_train, y_val]))\n    if scale < 1e-10:\n        scale = 1.0\n    y_train /= scale\n    y_val /= scale\n    return {'X': x_train, 'y': y_train, 'Xv': x_val, 'yv': y_val}\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    return capacity_scan(family, seed=seed)"
    },
