code_lab 最后一版书生代码:
import numpy as np


def family(kind, w, seed):
    # ===== 你只改这个函数: 定义"刚(rigid)/肥(fat)"各自对应的约束族 =====
    rng = np.random.default_rng(seed)
    if kind == 'rigid':
        # 刚性族：线性约束 f(x)=x，唯一解，低维（1维）
        x = np.linspace(0.0, 1.0, w).reshape(-1, 1)
        y = x
        xv = np.linspace(0.01, 0.99, 200).reshape(-1, 1)
        yv = xv
    elif kind == 'fat':
        # 肥族：高维多项式族，系数随机，连续自由度，不可唯一确定
        x = np.linspace(0.0, 1.0, w).reshape(-1, 1)
        coeffs = rng.standard_normal((20, 1))
        basis = (2 * x - 1) ** np.arange(20).reshape(20, 1)
        y = np.dot(basis, coeffs).reshape(-1, 1)
        y = y / (np.std(y) + 1e-8)  # 归一到 O(1)
        xv = np.linspace(0.01, 0.99, 200).reshape(-1, 1)
        basis_v = (2 * xv - 1) ** np.arange(20).reshape(20, 1)
        yv = np.dot(basis_v, coeffs).reshape(-1, 1)
        yv = yv / (np.std(yv) + 1e-8)
    else:
        x = np.linspace(0.0, 1.0, w).reshape(-1, 1)
        y = np.sin(np.pi * x)
        xv = np.linspace(0.01, 0.99, 200).reshape(-1, 1)
        yv = np.sin(np.pi * xv)
    return {'X': x, 'y': y, 'Xv': xv, 'yv': yv}


def run(cfg):
    # 已由脚手架提供: 训练/多起点/宽度扫描/零违规判据/N_c 汇总都在 capacity_scan 里。
    # **不要改这个函数, 也不要把训练/优化代码写进来** —— 否则会重蹈手搓 numpy 的错。
    seed = int(cfg.get('seed', 0))
    return capacity_scan(family, seed=seed)
