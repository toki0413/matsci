    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\nfrom scipy.optimize import minimize\n\ndef mlp_fit(X, y, h, seeds=3, seed=0):\n    rng = np.random.default_rng(seed)\n    best_model = None\n    best_loss = float('inf')\n    for s in range(seeds):\n        p0 = rng.standard_normal(2 * h * X.shape[1] + h + 1)\n        def loss(p):\n            W1 = p[:h * X.shape[1]].reshape(X.shape[1], h)\n            b1 = p[h * X.shape[1]:h * X.shape[1] + h]\n            W2 = p[h * X.shape[1] + h:-1].reshape(h, 1)\n            b2 = p[-1]\n            H = np.tanh(X @ W1 + b1)\n            out = H @ W2 + b2\n            return np.mean((out - y) ** 2)\n        res = minimize(loss, p0, method='L-BFGS-B', options={'maxiter': 20000})\n        if res.fun < best_loss:\n            best_loss = res.fun\n            best_model = {'W1': res.x[:h * X.shape[1]].reshape(X.shape[1], h),\n                          'b1': res.x[h * X.shape[1]:h * X.shape[1] + h],\n                          'W2': res.x[h * X.shape[1] + h:-1].reshape(h, 1),\n                          'b2': res.x[-1]}\n    return best_model\n\ndef mlp_predict(model, X):\n    H = np.tanh(X @ model['W1'] + model['b1'])\n    return H @ model['W2'] + model['b2']\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    ws = [5, 10, 20]\n    widths = [2, 4, 8, 16, 32]\n    anchor = None\n    summary = {}\n    objectives = {}\n    for w in ws:\n        X = np.linspace(0.0, 1.0, w).reshape(-1, 1)\n        y = np.sin(np.pi * X).reshape(-1, 1)\n        Xv = np.linspace(0.0, 1.0, 200).reshape(-1, 1)\n        yv = np.sin(np.pi * Xv).reshape(-1, 1)\n        for h in widths:\n            model = mlp_fit(X, y, h, seeds=3, seed=seed + 1000 * w + 10 * h)\n            tr = float(np.max(np.abs(mlp_predict(model, X) - y)))\n            ho = float(np.max(np.abs(mlp_predict(model, Xv) - yv)))\n            if anchor is None and ho <= 1e-3 and tr <= 1e-4:\n                anchor = {'w': w, 'h': h, 'train_err': tr, 'heldout_err': ho}\n            if anchor is None or ho < anchor['heldout_err']:\n                anchor = {'w': w, 'h': h, 'train_err': tr, 'heldout_err': ho}\n            summary['w%d_h%d' % (w, h)] = {'train_err': tr, 'heldout_err': ho}\n            objectives['neg_heldout_w%d_h%d' % (w, h)] = -ho\n    summary['anchor'] = anchor\n    nc_values = []\n    for w in ws:\n        nc = None\n        for h in widths:\n            key = 'w%d_h%d' % (w, h)\n            if summary[key]['heldout_err'] <= 1e-3 and summary[key]['train_err'] <= 1e-4:\n                nc = h\n                break\n        nc_values.append(nc if nc else float('inf'))\n    summary['Nc_w'] = nc_values\n    summary['Nc_trend'] = 'flat' if len(set(nc_values)) == 1 else 'decreasing' if nc_values == sorted(nc_values, reverse=True) else 'increasing'\n    summary['Nc_mean'] = float(np.mean([v if v != float('inf') else 32 for v in nc_values]))\n    summary['Nc_std'] = float(np.std([v if v != float('inf') else 32 for v in nc_values]))\n    objectives['Nc_mean'] = summary['Nc_mean']\n    objectives['Nc_trend'] = 1.0 if summary['Nc_trend'] == 'decreasing' else 0.5 if summary['Nc_trend'] == 'flat' else 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}\n\ndef probe_author_probe(cfg):\n    return {'note': 'Bootstrap check: anchor shows zero violation is reachable.'}"
    },
