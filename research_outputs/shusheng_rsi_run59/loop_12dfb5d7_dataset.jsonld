    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X_train = np.sort(rng.uniform(0.05, 0.95, w))[:, None]\n    Xv = np.sort(rng.uniform(0.02, 0.98, 50))[:, None]\n    # Rigid: single polynomial f(x) = x^2 (1D solution space)\n    if kind == 'rigid':\n        y = X_train ** 2\n        yv = Xv ** 2\n    # Fat: random polynomial coeffs per sample (high-dim solution space)\n    else:\n        coeffs = rng.standard_normal(3)\n        poly = np.poly1d(coeffs)\n        y = poly(X_train.ravel())[:, None]\n        yv = poly(Xv.ravel())[:, None]\n    # Scale to O(1)\n    scale = 1.0\n    return {'X': X_train / scale, 'y': y / scale, 'Xv': Xv / scale, 'yv': yv / scale}\n\ndef mlp_fit(X, y, h, seeds=3):\n    from scipy.optimize import minimize\n    n_in, n_out = X.shape[1], y.shape[1]\n    models = []\n    for s in range(seeds):\n        rng = np.random.default_rng(s)\n        W1 = rng.standard_normal((n_in, h)) / np.sqrt(n_in)\n        b1 = rng.standard_normal(h)\n        W2 = rng.standard_normal((h, n_out)) / np.sqrt(h)\n        b2 = rng.standard_normal(n_out)\n        \n        def params_to_array():\n            return np.concatenate([W1.ravel(), b1, W2.ravel(), b2])\n        \n        def array_to_params(p):\n            idx = h * n_in\n            W1 = p[:idx].reshape((n_in, h))\n            b1 = p[idx:idx+h]\n            idx += h\n            W2 = p[idx:idx+h*n_out].reshape((h, n_out))\n            b2 = p[idx+h*n_out:]\n            return W1, b1, W2, b2\n        \n        def loss_func(p):\n            W1, b1, W2, b2 = array_to_params(p)\n            Z1 = X @ W1 + b1\n            A1 = np.tanh(Z1)\n            Y_pred = A1 @ W2 + b2\n            return np.mean((Y_pred - y) ** 2)\n        \n        p0 = params_to_array()\n        res = minimize(loss_func, p0, method='L-BFGS-B', options={'maxiter': 1000})\n        W1, b1, W2, b2 = array_to_params(res.x)\n        models.append((W1, b1, W2, b2))\n    \n    # Select best model on validation (dummy val=X for simplicity)\n    best_loss = np.inf\n    best_model = None\n    for model in models:\n        W1, b1, W2, b2 = model\n        Z1 = X @ W1 + b1\n        A1 = np.tanh(Z1)\n        Y_pred = A1 @ W2 + b2\n        loss = np.mean((Y_pred - y) ** 2)\n        if loss < best_loss:\n            best_loss = loss\n            best_model = model\n    return best_model\n\ndef mlp_predict(model, X):\n    W1, b1, W2, b2 = model\n    Z1 = X @ W1 + b1\n    A1 = np.tanh(Z1)\n    return A1 @ W2 + b2\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_list = [10, 20, 50, 100]\n    h_list = list(range(4, 65, 4))\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'rigid_avg_Nc': 0.0, 'fat_avg_Nc': 0.0}\n    \n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        for w in w_list:\n            Nc_found = None\n            for h in h_list:\n                data = family(kind, w, seed + w * 100 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                pred = mlp_predict(model, Xv)\n                max_err = np.max(np.abs(pred - yv))\n                if max_err <= 1e-3:\n                    Nc_found = h\n                    break\n            Nc_list.append(Nc_found if Nc_found is not None else 64)\n        summary[f'{kind}_Nc'] = Nc_list\n        avg_Nc = np.mean([n for n in Nc_list if n < 64]) if any(n < 64 for n in Nc_list) else 64.0\n        objectives[f'{kind}_avg_Nc'] = float(avg_Nc)\n    \n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
