import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 100), 10) @ coeffs)
    if scale < 1e-10: scale = 1.0
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [5, 10, 20, 50]
    hs = [4, 8, 16, 32]
    max_h = 32
    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_fail': 0, 'fat_fail': 0}
    objectives = {'rigid_min_Nc': float('inf'), 'fat_min_Nc': float('inf')}
    for kind in ['rigid', 'fat']:
        for w in ws:
            Nc = None
            for h in hs:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.max(np.abs(pred - yv))
                if err <= 1e-3:
                    if Nc is None or h < Nc:
                        Nc = h
            if Nc is None:
                Nc = max_h + 1
            summary[f'{kind}_Nc'].append(Nc)
            if Nc > max_h:
                if kind == 'rigid': summary['rigid_fail'] += 1
                else: summary['fat_fail'] += 1
            if Nc < objectives[f'{kind}_min_Nc']:
                objectives[f'{kind}_min_Nc'] = Nc
    if objectives['rigid_min_Nc'] > max_h:
        objectives['rigid_min_Nc'] = max_h + 1
    if objectives['fat_min_Nc'] > max_h:
        objectives['fat_min_Nc'] = max_h + 1
