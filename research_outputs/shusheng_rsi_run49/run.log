code_lab 最后一版书生代码:
import numpy as np
from mlp_fit import mlp_fit, mlp_predict
from _as_2d import _as_2d
from poly_basis import poly_basis
from capacity_scan import capacity_scan

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    
    if kind == 'rigid':
        # 刚性族：唯一满足 y=x 的线性函数，低维解空间
        coeffs = np.array([0.0, 1.0])
    else:
        # 肥性族：y = a*x + b，a,b 连续变化，高维解空间
        coeffs = rng.standard_normal(2)
    
    X_basis = poly_basis(X, 2)
    Xv_basis = poly_basis(Xv, 2)
    y = (X_basis @ coeffs).reshape(-1, 1)
    yv = (Xv_basis @ coeffs).reshape(-1, 1)
    
    X_dense = np.linspace(0, 1, 1000).reshape(-1, 1)
    X_dense_basis = poly_basis(X_dense, 2)
    scale = np.std((X_dense_basis @ coeffs).reshape(-1))
    if scale < 1e-10:
        scale = 1.0
    y = y / scale
    yv = yv / scale
    
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    return capacity_scan(family, seed=seed)
