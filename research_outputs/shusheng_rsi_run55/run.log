import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        basis_X = poly_basis(X, 3)
        basis_Xv = poly_basis(Xv, 3)
        y = basis_X @ coeffs.reshape(-1, 1)
        yv = basis_Xv @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(5)
        basis_X = poly_basis(X, 5)
        basis_Xv = poly_basis(Xv, 5)
        y = basis_X @ coeffs.reshape(-1, 1)
        yv = basis_Xv @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 5) @ coeffs)
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    from sklearn.neural_network import MLPRegressor
    models = []
    for s in range(seeds):
        model = MLPRegressor(hidden_layer_sizes=(h,), activation='tanh', solver='lbfgs', max_iter=1000, random_state=s)
        model.fit(X.ravel(), y.ravel())
        models.append(model)
    return models

def mlp_predict(models, X):
    preds = np.array([model.predict(X.ravel()) for model in models])
    return np.mean(preds, axis=0).reshape(-1, 1)

def poly_basis(X, n):
    X = X.ravel()
    return np.array([X**i for i in range(n)]).T

def _as_2d(x):
    return x.reshape(-1, 1) if x.ndim == 1 else x

