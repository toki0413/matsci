import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        basis = poly_basis(X, 3)
        y = basis @ coeffs.reshape(-1, 1)
        basis_v = poly_basis(Xv, 3)
        yv = basis_v @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        basis = poly_basis(X, 10)
        y = basis @ coeffs.reshape(-1, 1)
        basis_v = poly_basis(Xv, 10)
        yv = basis_v @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 10) @ coeffs)
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    from scipy.optimize import minimize
    import torch
    import torch.nn as nn
    import torch.optim as optim
    class MLP(nn.Module):
        def __init__(self, in_h, h):
            super().__init__()
            self.net = nn.Sequential(nn.Linear(in_h, h), nn.Tanh(), nn.Linear(h, 1))
        def forward(self, x):
            return self.net(x)
    X_t = torch.FloatTensor(X)
    y_t = torch.FloatTensor(y)
    best_loss = np.inf
    best_state = None
    for seed in range(seeds):
        torch.manual_seed(seed)
        model = MLP(1, h)
        criterion = nn.MSELoss()
        optimizer = optim.LBFGS(model.parameters(), lr=1.0)
        for _ in range(500):
            def closure():
                optimizer.zero_grad()
                out = model(X_t)
                loss = criterion(out, y_t)
                loss.backward()
                return loss
            optimizer.step(closure)
        loss = criterion(model(X_t), y_t).item()
        if loss < best_loss:
            best_loss = loss
            best_state = model.state_dict()
    params = []
    for name, param in nn.ModuleDict({('net', nn.Sequential(nn.Linear(1, h), nn.Tanh(), nn.Linear(h, 1)))}).items():
