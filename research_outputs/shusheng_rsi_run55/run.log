    hs = [4, 8, 16, 32, 64, 128]
    summary = {'rigid': {}, 'fat': {}}
    objectives = {'rigid_Nc': [], 'fat_Nc': []}
    for kind in ['rigid', 'fat']:
        summary[kind] = {}
        for w in ws:
            summary[kind][w] = {'Nc': None, 'errors': []}
            for h in hs:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                yp = mlp_predict(model, Xv)
                err = np.max(np.abs(yp - yv))
                summary[kind][w]['errors'].append((h, err))
                if err <= 1e-3 and summary[kind][w]['Nc'] is None:
                    summary[kind][w]['Nc'] = h
            nc = summary[kind][w]['Nc'] if summary[kind][w]['Nc'] is not None else 128
            summary[kind][w]['Nc'] = float(nc)
            if kind == 'rigid':
                objectives['rigid_Nc'].append(float(nc))
            else:
                objectives['fat_Nc'].append(float(nc))
    return {'success': True, 'summary': summary, 'objectives': objectives}
