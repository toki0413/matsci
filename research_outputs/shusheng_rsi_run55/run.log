import numpy as np

def mlp_fit(X, y, h, seeds=3):
    def forward(W, x):
        a1 = np.tanh(x @ W[0] + b[0])
        return a1 @ W[1] + b[1]
    def loss_func(params):
        W = [params[:h*2].reshape(h, 2), params[2*h:2*h+h].reshape(2, 1)]
        b = [params[2*h+h:2*h+2*h].reshape(h, 1), params[2*h+2*h:].reshape(1, 1)]
        pred = forward(W, X)
        return np.mean((pred - y) ** 2)
    best = None
    for _ in range(seeds):
        W0 = [np.random.randn(h, 2), np.random.randn(2, 1)]
        b0 = [np.random.randn(h, 1), np.random.randn(1, 1)]
        init = np.concatenate([W0[0].ravel(), W0[1].ravel(), b0[0].ravel(), b0[1].ravel()])
        from scipy.optimize import minimize
        res = minimize(loss_func, init, method='L-BFGS-B')
        if best is None or res.fun < best[0]:
            best = (res.fun, res.x)
    W = [best[1][:h*2].reshape(h, 2), best[1][h*2:2*h].reshape(2, 1)]
    b = [best[1][2*h:2+h].reshape(h, 1), best[1][2+h:2+h+1].reshape(1, 1)]
    return (W, b)

def mlp_predict(model, Xv):
    W, b = model
    a1 = np.tanh(Xv @ W[0] + b[0])
    return a1 @ W[1] + b[1]

def poly_basis(X, n):
    X = X.ravel()
    return np.array([X**i for i in range(n)]).T

def _as_2d(x):
    return x.reshape(-1, 1) if x.ndim == 1 else x

