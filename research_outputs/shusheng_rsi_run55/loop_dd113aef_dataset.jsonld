  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "mode",
      "value": "code_lab"
    },
    {
      "@type": "PropertyValue",
      "name": "description",
      "value": "Create a Python script to conduct the numerical experiment on small feedforward networks. The script will: (1) Define a set of analytical constraints (e.g., a target function with known properties), (2) Sweep over constraint counts w and hidden layer widths N, (3) Train networks on w samples, (4) Evaluate zero-violation (max abs error ≤ 1e-3) on held-out constraints, (5) Compute N_c(w) as the minimal width achieving zero violation, and (6) Output results to verify if the solution space is rigid (small finite N_c independent of w) or fat (N_c unattainable)."
    },
    {
      "@type": "PropertyValue",
      "name": "skill",
      "value": "None"
    },
    {
      "@type": "PropertyValue",
      "name": "expected_prediction",
      "value": "The experiment will yield a finite N_c(w) for small w that either plateaus or grows slowly, indicating rigidity; if N_c exceeds the search width or grows linearly with w, it indicates fatness. The prediction is that small feedforward networks will exhibit rigidity for smooth analytical constraints, with N_c < 50 and weak dependence on w."
    },
    {
      "@type": "PropertyValue",
      "name": "prediction_inputs"
    },
    {
      "@type": "PropertyValue",
      "name": "target_files"
    },
    {
      "@type": "PropertyValue",
      "name": "plan_id",
      "value": "plan_4088c5d7"
    },
    {
      "@type": "PropertyValue",
