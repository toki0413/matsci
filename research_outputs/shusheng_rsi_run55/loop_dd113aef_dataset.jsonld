      "@type": "PropertyValue",
      "name": "objectives.fat_Nc_avg",
      "value": 5.333333333333333
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])  # x^2 - 2x + 1 = (x-1)^2，唯一二次函数\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:  # 'fat'\n        coeffs = rng.standard_normal(3)\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    scale = np.std(poly_basis(np.linspace(0,1,100), 3) @ coeffs) if kind == 'fat' else 1.0\n    y = y / scale\n    yv = yv / scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_vals = [5, 10, 20, 50]\n    h_vals = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_failed': [], 'fat_failed': []}\n    objectives = {'score': 0.0, 'rigid_Nc_avg': 0.0, 'fat_Nc_avg': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        failed_count = 0\n        for w in w_vals:\n            Nc_found = None\n            for h in h_vals:\n                data = family(kind, w, seed + w * 100 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(pred - yv))\n                if err <= 1e-3:\n                    Nc_found = h\n                    break\n            if Nc_found is not None:\n                Nc_list.append(Nc_found)\n            else:\n                Nc_list.append(None)\n                failed_count += 1\n        if kind == 'rigid':\n            summary['rigid_Nc'] = Nc_list\n            summary['rigid_failed'] = failed_count\n            finite_Nc = [n for n in Nc_list if n is not None]\n            if finite_Nc:\n                objectives['rigid_Nc_avg'] = np.mean(finite_Nc)\n                objectives['score'] += 1.0 / (1 + np.mean(finite_Nc))\n            else:\n                objectives['rigid_Nc_avg'] = 1e9\n        else:\n            summary['fat_Nc'] = Nc_list\n            summary['fat_failed'] = failed_count\n            finite_Nc = [n for n in Nc_list if n is not None]\n            if finite_Nc:\n                objectives['fat_Nc_avg'] = np.mean(finite_Nc)\n                # 胖族应无解，若有解则降分\n                objectives['score'] -= 0.5 * np.mean(finite_Nc) / max(h_vals)\n            else:\n                objectives['fat_Nc_avg'] = 1e9\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
