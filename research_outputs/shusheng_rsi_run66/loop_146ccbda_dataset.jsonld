    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    y = np.sin(np.pi * X)\n    yv = np.sin(np.pi * Xv)\n    scale = np.std(np.sin(np.pi * np.linspace(0, 1, 1000)))\n    y /= scale\n    yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef mlp_fit(X, y, h, seeds=3):\n    from sklearn.neural_network import MLPRegressor\n    models = []\n    for s in range(seeds):\n        rng = np.random.default_rng(s)\n        model = MLPRegressor(hidden_layer_sizes=(h,), activation='relu',\n                               solver='lbfgs', max_iter=10000, random_state=s)\n        model.fit(X.ravel(), y.ravel())\n        models.append(model)\n    best = None\n    best_err = np.inf\n    for m in models:\n        err = np.max(np.abs(m.predict(X.ravel()) - y.ravel()))\n        if err < best_err:\n            best_err = err\n            best = m\n    return best\n\ndef mlp_predict(model, X):\n    return model.predict(X.ravel()).reshape(-1, 1)\n\ndef poly_basis(X, n):\n    X = X.ravel()\n    return np.array([X**i for i in range(n)]).T\n\ndef _as_2d(x):\n    return x.reshape(-1, 1)\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_vals = [4, 8, 16, 32, 64, 128]\n    h_vals = [8, 16, 32, 64, 128, 256]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': {}, 'fat_errors': {}}\n    objectives = {'score': 0.0, 'rigid_Nc_mean': 0.0, 'fat_Nc_mean': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        errors_dict = {}\n        for w in w_vals:\n            Nc_found = None\n            w_errors = []\n            for h in h_vals:\n                data = family(kind, w, seed + w * 1000 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(pred - yv))\n                w_errors.append(err)\n                if err <= 1e-3:\n                    if Nc_found is None or h < Nc_found:\n                        Nc_found = h\n            if Nc_found is None:\n                Nc_found = 999\n            Nc_list.append(Nc_found)\n            errors_dict[w] = w_errors\n            summary[f'{kind}_Nc'].append(Nc_found)\n            summary[f'{kind}_errors'][w] = w_errors\n        if kind == 'rigid':\n            objectives['rigid_Nc_mean'] = np.mean(Nc_list)\n            objectives['score'] = np.mean([1 if n < 50 else 0 for n in Nc_list])\n        else:\n            objectives['fat_Nc_mean'] = np.mean(Nc_list)\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
