import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([0., np.pi])
        y = np.sin(np.pi * X) @ coeffs.reshape(1, -1)
        yv = np.sin(np.pi * Xv) @ coeffs.reshape(1, -1)
    else:
        coeffs = rng.standard_normal(10)
        Xb = poly_basis(X, 10)
        Xvb = poly_basis(Xv, 10)
        y = Xb @ coeffs.reshape(-1, 1)
        yv = Xvb @ coeffs.reshape(-1, 1)
    scale = np.std(np.concatenate([y.flatten(), yv.flatten()]))
    return {'X': X, 'y': y / scale, 'Xv': Xv, 'yv': yv / scale}

def poly_basis(X, n):
    return np.array([X.flatten()**i for i in range(n)]).T

def _as_2d(x):
    return x.reshape(-1, 1)

def mlp_fit(X, y, h, seeds=3):
    import scipy.optimize as opt
    def forward(X, params):
        w1, b1, w2, b2 = params
        h1 = np.tanh(X @ w1 + b1)
        return h1 @ w2 + b2
    def loss_func(params):
        return np.mean((forward(X, params) - y) ** 2)
    def grad_func(params):
        eps = 1e-6
        g = np.zeros_like(params)
        for i in range(len(params)):
            p_plus = params.copy(); p_plus[i] += eps
            p_minus = params.copy(); p_minus[i] -= eps
            g[i] = (loss_func(p_plus) - loss_func(p_minus)) / (2 * eps)
        return g
    best_loss, best_params = float('inf'), None
    for s in range(seeds):
        rng = np.random.default_rng(s)
        w1 = rng.standard_normal((X.shape[1], h)) / np.sqrt(X.shape[1])
        b1 = np.zeros((h, 1))
        w2 = rng.standard_normal((h, 1)) / np.sqrt(h)
        b2 = np.zeros((1, 1))
        params = [w1.flatten(), b1.flatten(), w2.flatten(), b2.flatten()]
        res = opt.minimize(loss_func, params, method='L-BFGS-B', jac=grad_func, options={'maxiter': 10000})
        if res.fun < best_loss:
            best_loss, best_params = res.fun, res.x
    return {'params': best_params, 'h': h, 
