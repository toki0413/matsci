import numpy as np
from mlp_fit import mlp_fit
from mlp_predict import mlp_predict
from poly_basis import poly_basis
from _as_2d import _as_2d

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    y_true = np.sin(np.pi * X)
    yv_true = np.sin(np.pi * Xv)
    noise_std = 1e-4
    y = y_true + rng.standard_normal((w, 1)) * noise_std
    yv = yv_true
    scale = np.std(np.sin(np.pi * np.linspace(0, 1, 1000)))
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [10, 50, 100, 150, 200]
    hs = [8, 16, 32, 64, 128, 256]
    summary = {'rigid_Nc': [], 'fat_Nc': [], 'errors': []}
    objectives = {'score': 0.0}
    for w in ws:
        Nc_rigid = None
        for h in hs:
            X, y, Xv, yv = family('rigid', w, seed + w * 100 + h)
            model = mlp_fit(X, y, h, seeds=3)
            yp = mlp_predict(model, Xv)
            err = float(np.max(np.abs(yv - yp)))
            summary['errors'].append((w, h, err))
            if err <= 1e-3:
                if Nc_rigid is None or h < Nc_rigid:
                    Nc_rigid = h
        summary['rigid_Nc'].append(Nc_rigid if Nc_rigid is not None else 999)
        Nc_fat = None
        for h in hs:
            X, y, Xv, yv = family('fat', w, seed + w * 1000 + h)
            model = mlp_fit(X, y, h, seeds=3)
            yp = mlp_predict(model, Xv)
            err = float(np.max(np.abs(yv - yp)))
            if err <= 1e-3:
                if Nc_fat is None or h < Nc_fat:
                    Nc_fat = h
        summary['fat_Nc'].append(Nc_fat if Nc_fat is not None else 999)
    rigid_finite = all(isinstance(v, (int, float)) and v < 999 for v in summary['rigid_Nc'])
    fat_infinite = all(v >= 999 for v in summary['fat_Nc'])
    score = 1.0 if (rigid_finite and fat_infinite) else 0.0
    objectives['score'] = float(score)
 
