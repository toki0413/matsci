import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        y = np.sin(np.pi * X)
        yv = np.sin(np.pi * Xv)
    elif kind == 'fat':
        n_coeffs = 10
        coeffs = rng.standard_normal(n_coeffs)
        Xb = poly_basis(X, n_coeffs)
        Xvb = poly_basis(Xv, n_coeffs)
        y = Xb @ coeffs + rng.standard_normal((w, 1)) * 1e-4
        yv = Xvb @ coeffs + rng.standard_normal((200, 1)) * 1e-4
        scale = np.std(yv)
        y = y / scale
        yv = yv / scale
        return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}
    scale = np.std(np.sin(np.pi * np.linspace(0, 1, 1000)))
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    w_vals = [10, 20, 50, 100, 200]
    h_vals = [4, 8, 16, 32, 64]
    summary = {'rigid': {}, 'fat': {}}
    objectives = {'rigid_Nc_max': 0.0, 'fat_Nc_reach': 0.0}
    for kind in ['rigid', 'fat']:
        summary[kind] = {}
        for w in w_vals:
            summary[kind][w] = {}
            Nc_list = []
            for h in h_vals:
                max_errors = []
                for rep in range(5):
                    s = seed + rep * 1000
                    data = family(kind, w, s)
                    X, y = data['X'], data['y']
                    Xv, yv = data['Xv'], data['yv']
                    model = mlp_fit(X, y, h, seeds=3)
                    yv_pred = mlp_predict(model, Xv)
                    err = np.max(np.abs(yv_pred - yv))
                    max_errors.append(float(err))
                avg_err = np.mean(max_errors)
                summary[kind][w][h] = {'avg_error': avg_err}
                if all(e <= 1e-3 for e in max_errors):
                    Nc_list.append(h)
                    break
            summary[kind][w]['Nc'] = min(Nc_list) if Nc_list else 1e9
    
