    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, 0.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(50)\n        y = poly_basis(X, 50) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 50) @ coeffs.reshape(-1, 1)\n    scale = np.std(np.vstack((y, yv)))\n    y /= scale\n    yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [4, 8]\n    hs = list(range(2, 11))\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        nc_list = []\n        for w in ws:\n            nc = 51\n            for h in hs:\n                data = family(kind, w, seed + w * 10 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=1)\n                y_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(y_pred - yv))\n                if zero_violation(err):\n                    nc = h\n                    break\n            nc_list.append(nc)\n        summary[f'{kind}_Nc'] = nc_list\n        avg_nc = np.mean(nc_list)\n        if kind == 'rigid':\n            objectives['score'] += (1.0 / (avg_nc + 1e-6))\n        else:\n            objectives['score'] -= (avg_nc / 51.0)\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
