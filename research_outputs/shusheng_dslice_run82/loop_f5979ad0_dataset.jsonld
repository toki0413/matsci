    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(10)\n        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)\n    scale = np.std(np.vstack((Xv, X)).ravel())\n    y /= scale\n    yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_list = [2, 3, 4]\n    h_list = [3, 4, 5]\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'rigid_mean_Nc': 0.0, 'fat_mean_Nc': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_values = []\n        for w in w_list:\n            Nc_found = None\n            for h in h_list:\n                data = family(kind, w, seed + w * 1000 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=1)\n                pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(pred - yv))\n                if zero_violation(err):\n                    if Nc_found is None or h < Nc_found:\n                        Nc_found = h\n                    break\n            Nc_values.append(Nc_found if Nc_found is not None else h_list[-1])\n        summary[f'{kind}_Nc'] = Nc_values\n        mean_Nc = float(np.mean(Nc_values))\n        objectives[f'{kind}_mean_Nc'] = mean_Nc if np.isfinite(mean_Nc) else 1e6\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
