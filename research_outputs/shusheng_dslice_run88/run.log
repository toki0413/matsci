import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        t = rng.uniform(0, 2 * np.pi)
        coeffs = np.array([1.0, 0.5])
        y = coeffs[0] * np.sin(2 * np.pi * X + t) + coeffs[1] * np.cos(2 * np.pi * X + t)
        yv = coeffs[0] * np.sin(2 * np.pi * Xv + t) + coeffs[1] * np.cos(2 * np.pi * Xv + t)
    else:
        coeffs = rng.standard_normal(10)
        basis = poly_basis(X, 10)
        y = basis @ coeffs.reshape(-1, 1)
        basis_v = poly_basis(Xv, 10)
        yv = basis_v @ coeffs.reshape(-1, 1)
    scale = np.std(np.concatenate([y.flatten(), yv.flatten()]))
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

