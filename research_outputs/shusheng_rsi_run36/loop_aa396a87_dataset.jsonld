    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef poly_basis(X, n):\n    N = X.shape[0]\n    X_flat = X.flatten()\n    return np.array([X_flat**i for i in range(n)]).T\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n        y = np.sin(np.pi * X)\n        Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n        yv = np.sin(np.pi * Xv)\n    else:\n        n = 20\n        coeffs = rng.standard_normal(n)\n        X = rng.uniform(0.05, 0.95, (w, 1))\n        y = (poly_basis(X, n) @ coeffs).reshape(-1, 1)\n        Xv = rng.uniform(0.02, 0.98, (200, 1))\n        yv = (poly_basis(Xv, n) @ coeffs).reshape(-1, 1)\n        grid = np.linspace(0.02, 0.98, 400).reshape(-1, 1)\n        s = float(np.std(poly_basis(grid, n) @ coeffs)) + 1e-9\n        y = y / s\n        yv = yv / s\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    return capacity_scan(family, seed=seed)"
    },
