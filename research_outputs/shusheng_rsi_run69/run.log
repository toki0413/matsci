import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 10) @ coeffs)
    if scale > 1e-10:
        y = y / scale
        yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    from scipy.optimize import minimize
    import torch
    import torch.nn as nn
    import torch.optim as optim
    X_ = X.astype(np.float32)
    y_ = y.astype(np.float32)
    models = []
    for s in range(seeds):
        torch.manual_seed(s)
        class Net(nn.Module):
            def __init__(self):
                super().__init__()
                self.fc1 = nn.Linear(1, h)
                self.fc2 = nn.Linear(h, 1)
            def forward(self, x):
                return torch.tanh(self.fc2(torch.tanh(self.fc1(x))))
        net = Net()
        optimizer = optim.LBFGS(net.parameters(), lr=1.0)
        X_t = torch.from_numpy(X_)
        y_t = torch.from_numpy(y_)
        for _ in range(500):
            def closure():
                optimizer.zero_grad()
                out = net(X_t)
                loss = nn.MSELoss()(out, y_t)
                loss.backward()
                return loss
            optimizer.step(closure)
        models.append(net)
    best = None
    best_err = np.inf
    for net in models:
        with torch.no_grad():
            out = net(torch.from_numpy(X_)).numpy()
        err = np.mean((out - y_) ** 2)
        if err < best_err:
            best_err = err
            best = net
    return best

def mlp
