    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        d = w - 1\n        X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n        Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n        coeffs = np.zeros(d + 1)\n        coeffs[0] = 1.0\n        coeffs[1] = -0.5\n        y = poly_basis(X, d + 1) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, d + 1) @ coeffs.reshape(-1, 1)\n    else:\n        d = 2 * w\n        X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n        Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n        coeffs = rng.standard_normal(d + 1)\n        y = poly_basis(X, d + 1) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, d + 1) @ coeffs.reshape(-1, 1)\n    scale = np.std(poly_basis(np.linspace(0, 1, 1000), d + 1) @ coeffs)\n    if scale < 1e-10: scale = 1.0\n    y = y / scale\n    yv = yv / scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_list = [3, 5, 7, 9]\n    h_list = [4, 8, 16, 32]\n    summary = {'rigid': {}, 'fat': {}}\n    objectives = {'rigid_Nc_max': 0.0, 'fat_Nc_max': 0.0}\n    for kind in ['rigid', 'fat']:\n        summary[kind] = {}\n        nc_max = 0.0\n        for w in w_list:\n            summary[kind][w] = {}\n            for h in h_list:\n                data = family(kind, w, seed + w * 1000 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(yv_pred - yv))\n                ok = zero_violation(err)\n                summary[kind][w][h] = {'err': float(err), 'ok': bool(ok)}\n                if ok and h > nc_max:\n                    nc_max = float(h)\n            summary[kind][w]['min_Nc'] = nc_max if nc_max > 0.0 else 32.0\n            if kind == 'rigid':\n                objectives['rigid_Nc_max'] = max(objectives['rigid_Nc_max'], nc_max)\n            else:\n                objectives['fat_Nc_max'] = max(objectives['fat_Nc_max'], nc_max)\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
