    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    w_list = [4, 8, 16, 32]\n    max_width = 64\n    n_trials = 3\n    N_c_vals = []\n    train_viol, val_viol = [], []\n    for w in w_list:\n        widths_found = []\n        for _ in range(n_trials):\n            found = False\n            for width in range(2, max_width + 1):\n                W1 = rng.standard_normal((2, width)) * 0.1\n                b1 = rng.uniform(-0.1, 0.1, size=(width,))\n                W2 = rng.standard_normal((width, 1)) * 0.1\n                b2 = rng.uniform(-0.1, 0.1, size=(1,))\n                X_train = rng.standard_normal((w, 2))\n                y_train = (X_train[:, 0] + X_train[:, 1] > 0).astype(float).reshape(-1, 1)\n                for _ in range(500):\n                    z1 = X_train @ W1 + b1\n                    a1 = np.tanh(z1)\n                    z2 = a1 @ W2 + b2\n                    y_pred = (z2 > 0).astype(float)\n                    loss = np.mean((y_train - y_pred) ** 2)\n                    if loss < 1e-5:\n                        widths_found.append(width)\n                        found = True\n                        break\n                    dL_dy = -2 * (y_train - y_pred) / y_train.shape[0]\n                    dL_dz2 = dL_dy\n                    dL_dW2 = a1.T @ dL_dz2\n                    dL_da1 = dL_dz2 @ W2.T\n                    dL_dz1 = dL_da1 * (1 - a1 ** 2)\n                    dL_dW1 = X_train.T @ dL_dz1\n                    dL_db1 = np.sum(dL_dz1, axis=0)\n                    W1 -= 0.1 * dL_dW1\n                    b1 -= 0.1 * dL_db1\n                    W2 -= 0.1 * dL_dW2\n                    b2 -= 0.1 * np.sum(dL_dz2, axis=0)\n                if found:\n                    break\n            if not found:\n                widths_found.append(max_width)\n        N_c = np.mean(widths_found)\n        N_c_vals.append(N_c)\n        train_viol.append(np.mean(widths_found) / max_width)\n        val_viol.append(np.mean(widths_found) / max_width)\n    trend = \"decreasing\" if np.all(np.diff(N_c_vals) <= 0) and np.any(np.diff(N_c_vals) < 0) else \"flat\"\n    return {\"success\": True, \"summary\": {\"N_c_w\": N_c_vals, \"trend\": trend, \"train_viol\": train_viol, \"val_viol\": val_viol}, \"objectives\": {\"score\": float(np.mean(N_c_vals))}}\ndef probe_author_probe(cfg):\n    return {\"note\": \"实验基于线性可分约束族，刚性对应低维解空间，胖对应高维连续族\"}"
    },
