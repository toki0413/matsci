import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        y = np.sin(2 * np.pi * X) + 0.5 * np.sin(6 * np.pi * X)
        yv = np.sin(2 * np.pi * Xv) + 0.5 * np.sin(6 * np.pi * Xv)
    else:
        coeffs = rng.standard_normal(w)
        X_power = poly_basis(X, w)
        y = X_power @ coeffs.reshape(-1, 1)
        Xv_power = poly_basis(Xv, w)
        yv = Xv_power @ coeffs.reshape(-1, 1)
    scale = np.std(np.sin(2 * np.pi * np.linspace(0, 1, 1000)))
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def poly_basis(X, n):
    N = X.shape[0]
    X_flat = X.flatten()
    return np.column_stack([X_flat ** i for i in range(n)])

def _as_2d(arr):
    return arr.reshape(-1, 1)

def zero_violation(err):
    return np.max(np.abs(err)) <= 1e-3

def mlp_fit(X, y, h, seeds=1, maxiter=500):
    import torch
    import torch.nn as nn
    X_t = torch.FloatTensor(X)
    y_t = torch.FloatTensor(y)
    best_model = None
    best_err = float('inf')
    for seed in range(seeds):
        torch.manual_seed(seed)
        model = nn.Sequential(
            nn.Linear(1, h),
            nn.ReLU(),
            nn.Linear(h, 1)
        )
        optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)
        for _ in range(maxiter):
            optimizer.zero_grad()
            y_pred = model(X_t)
            loss = nn.MSELoss()(y_pred, y_t)
            loss.backward()
            optimizer.step()
        with torch.no_grad():
            train_err = np.max(np.abs((model(X_t) - y_t).numpy()))
        if train_err < best_err:
            best_err = train_err
            best_model = model
    return best_model

def mlp_predict(model, Xv):
    import torch
    Xv_t = torch.FloatTensor(Xv)
    with torch.no_grad():
        return model(Xv_t).numpy()

