    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        X = np.linspace(0.1, 0.9, w).reshape(-1, 1)\n        Xv = np.linspace(0.05, 0.95, 200).reshape(-1, 1)\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        X = np.linspace(0.1, 0.9, w).reshape(-1, 1)\n        Xv = np.linspace(0.05, 0.95, 200).reshape(-1, 1)\n        coeffs = rng.standard_normal(10)\n        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)\n    scale = np.std(np.concatenate([y.flatten(), yv.flatten()]))\n    y = y / scale\n    yv = yv / scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_list = [4, 6, 8, 10, 12, 15]\n    h_list = [2, 4, 8, 16, 32]\n    summary = {'rigid': {}, 'fat': {}}\n    objectives = {'rigid_Nc_mean': 0.0, 'fat_Nc_mean': 0.0, 'rigid_fat_diff': 0.0}\n    for kind in ['rigid', 'fat']:\n        summary[kind] = {}\n        nc_vals = []\n        for w in w_list:\n            nc_vals_w = []\n            for h in h_list:\n                data = family(kind, w, seed + w * 1000 + h)\n                X, y = _as_2d(data['X']), _as_2d(data['y'])\n                Xv, yv = _as_2d(data['Xv']), _as_2d(data['yv'])\n                model = mlp_fit(X, y, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(yv_pred - yv))\n                if err <= 1e-3:\n                    nc_vals_w.append(h)\n                    break\n            if nc_vals_w:\n                nc_vals.append(min(nc_vals_w))\n            else:\n                nc_vals.append(h_list[-1])\n        summary[kind]['Nc_w'] = nc_vals\n        avg_nc = float(np.mean(nc_vals))\n        objectives[f'{kind}_Nc_mean'] = avg_nc\n    objectives['rigid_fat_diff'] = float(objectives['rigid_Nc_mean'] - objectives['fat_Nc_mean'])\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
