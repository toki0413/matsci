import numpy as np

def poly_basis(X, n):
    X = np.asarray(X).flatten()
    return np.array([X**i for i in range(n)]).T

def _as_2d(x):
    return x.reshape(-1, 1) if np.ndim(x) == 1 else x

def mlp_fit(X, y, h, seeds=3):
    from scipy.optimize import minimize
    X = _as_2d(X)
    y = _as_2d(y)
    N, D = X.shape
    best = None
    for s in range(seeds):
        rng = np.random.default_rng(s)
        W1 = rng.randn(D, h) * np.sqrt(1.0/D)
        b1 = np.zeros(h)
        W2 = rng.randn(h, 1) * np.sqrt(1.0/h)
        b2 = np.zeros(1)
        def params(): return np.concatenate([W1.ravel(), b1, W2.ravel(), b2])
        def inv(p):
            W1 = p[:D*h].reshape(D, h)
            b1 = p[D*h:D*h+h]
            W2 = p[D*h+h:D*h+h*h].reshape(h, 1)
            b2 = p[D*h+h*h:]
            return W1, b1, W2, b2
        def loss(p):
            W1, b1, W2, b2 = inv(p)
            h1 = np.tanh(X @ W1 + b1)
            y_pred = h1 @ W2 + b2
            return np.mean((y_pred - y)**2)
        p0 = params()
        p0 += rng.randn(len(p0)) * 1e-5
        res = minimize(loss, p0, method='L-BFGS-B', options={'maxiter': 1000, 'ftol': 1e-12})
        if best is None or res.fun < best[1]:
            best = (res.x, res.fun)
    W1, b1, W2, b2 = inv(best[0])
    return (W1, b1, W2, b2)

def mlp_predict(model, X):
    X = _as_2d(X)
    W1, b1, W2, b2 = model
    h1 = np.tanh(X @ W1 + b1)
    return h1 @ W2 + b2

