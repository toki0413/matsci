import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    n_poly = 5
    coeffs = rng.standard_normal(n_poly)
    X_basis = poly_basis(X, n_poly)
    y = (X_basis @ coeffs).reshape(-1, 1)
    Xv_basis = poly_basis(Xv, n_poly)
    yv = (Xv_basis @ coeffs).reshape(-1, 1)
    if kind == 'fat':
        coeffs[2] += rng.standard_normal() * 0.1
        yv = (Xv_basis @ coeffs).reshape(-1, 1)
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    import torch
    import torch.nn as nn
    import torch.optim as optim
    X_t = torch.tensor(X, dtype=torch.float32)
    y_t = torch.tensor(y, dtype=torch.float32)
    best_model = None
    best_loss = float('inf')
    for seed in range(seeds):
        torch.manual_seed(seed)
        model = nn.Sequential(
            nn.Linear(1, h),
            nn.Tanh(),
            nn.Linear(h, 1)
        )
        optimizer = optim.LBFGS(model.parameters(), lr=1.0)
        for _ in range(500):
            def closure():
                optimizer.zero_grad()
                y_pred = model(X_t)
                loss = nn.MSELoss()(y_pred, y_t)
                loss.backward()
                return loss
            optimizer.step(closure)
        with torch.no_grad():
            loss = nn.MSELoss()(model(X_t), y_t).item()
        if loss < best_loss:
            best_loss = loss
            best_model = model
    return best_model

def mlp_predict(model, Xv):
    import torch
    Xv_t = torch.tensor(Xv, dtype=torch.float32)
    with torch.no_grad():
        return model(Xv_t).numpy()

def poly_basis(X, n):
    X = X.flatten()
    return np.array([X**i for i in range(n)]).T

def _as_2d(x):
    if x.ndim == 1:
        return x.reshape(-1, 1)
    return x

