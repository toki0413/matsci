import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    n_poly = 5
    coeffs = rng.standard_normal(n_poly)
    X_basis = poly_basis(X, n_poly)
    y = (X_basis @ coeffs).reshape(-1, 1)
    Xv_basis = poly_basis(Xv, n_poly)
    yv = (Xv_basis @ coeffs).reshape(-1, 1)
    if kind == 'fat':
        coeffs[2] += rng.standard_normal() * 0.1
        yv = (Xv_basis @ coeffs).reshape(-1, 1)
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    import torch
    import torch.nn as nn
    import torch.optim as optim
    X_t = torch.tensor(X, dtype=torch.float32)
    y_t = torch.tensor(y, dtype=torch.float32)
    best_model = None
    best_loss = float('inf')
