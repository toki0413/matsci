        coeffs = rng.standard_normal(2)
        poly_basis_X = poly_basis(X, 2)
        poly_basis_Xv = poly_basis(Xv, 2)
        y = (poly_basis_X @ coeffs).reshape(-1, 1)
        yv = (poly_basis_Xv @ coeffs).reshape(-1, 1)
    scale = np.std(np.vstack([X.flatten(), Xv.flatten()]))
    if scale < 1e-10:
        scale = 1.0
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

