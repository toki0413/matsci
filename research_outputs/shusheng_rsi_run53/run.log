import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs
        yv = poly_basis(Xv, 3) @ coeffs
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs
        yv = poly_basis(Xv, 10) @ coeffs
    y = y.reshape(-1, 1)
    yv = yv.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 100), 10) @ coeffs)
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}


def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [4, 8, 16, 32]
    hs = [4, 8, 16, 32, 64]
    summary = {'rigid': {}, 'fat': {}}
    objectives = {'rigid_Nc_max': 0.0, 'fat_Nc_reached': 0.0}
    for kind in ['rigid', 'fat']:
        summary[kind] = {}
        for w in ws:
            Nc = None
            for h in hs:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.max(np.abs(pred - yv))
                if err <= 1e-3:
                    Nc = h
                    break
            summary[kind][w] = Nc if Nc is not None else 999
            if kind == 'rigid':
                objectives['rigid_Nc_max'] = max(objectives['rigid_Nc_max'], Nc if Nc else 999)
            else:
                if Nc == 999:
                    objectives['fat_Nc_reached'] = 1.0
    return {'success': True, 'summary': summary, 'objectives': objectives}
