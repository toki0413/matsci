    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(10)\n        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_list = [5, 10, 20, 50]\n    h_list = [1, 2, 3, 4, 5, 6, 7, 8]\n    summary = {'rigid_Nc': [], 'fat_Nc': []}\n    objectives = {'rigid_score': 0.0, 'fat_score': 0.0}\n    scale = 1.0\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        for w in w_list:\n            data = family(kind, w, seed + w * 100)\n            X, y = data['X'], data['y']\n            Xv, yv = data['Xv'], data['yv']\n            Nc_found = None\n            for h in h_list:\n                model = mlp_fit(X, y, h, seeds=3)\n                y_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(y_pred - yv))\n                if err <= 1e-3:\n                    Nc_found = h\n                    break\n            if Nc_found is None:\n                Nc_found = h_list[-1] + 1\n            Nc_list.append(Nc_found)\n            summary[f'{kind}_w{w}_Nc'] = float(Nc_found)\n            summary[f'{kind}_w{w}_err_min'] = float(np.inf)\n            for h in h_list:\n                model = mlp_fit(X, y, h, seeds=3)\n                y_pred = mlp_predict(model, Xv)\n                err = np.max(np.abs(y_pred - yv))\n                if err <= 1e-3:\n                    summary[f'{kind}_w{w}_err_min'] = float(err)\n                    break\n        avg_Nc = np.mean(Nc_list)\n        if kind == 'rigid':\n            objectives['rigid_score'] = float(avg_Nc)\n            summary['rigid_avg_Nc'] = float(avg_Nc)\n            summary['rigid_constant'] = 1.0 if max(Nc_list) - min(Nc_list) <= 1 else 0.0\n        else:\n            objectives['fat_score'] = float(avg_Nc)\n            summary['fat_avg_Nc'] = float(avg_Nc)\n            summary['fat_growing'] = 1.0 if Nc_list[-1] > Nc_list[0] else 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
