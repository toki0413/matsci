    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef poly_basis(X, n):\n    \"\"\"多项式基函数：返回 (N, n) 矩阵，第 j 列为 X^j\"\"\"\n    return np.power(X, np.arange(n))\n\n\ndef family(kind, w, seed):\n    # ===== 你只改这个函数: 定义\"刚(rigid)/肥(fat)\"各自对应的约束族 =====\n    # kind: 族名('rigid' 或 'fat'); w: 训练约束点数; seed: 随机种子\n    # 返回 dict {'X','y','Xv','yv'}: X/y 是 w 个训练约束点, Xv/yv 是留出约束点。\n    # 下面是**两个可跑通的示例**, 请按你的解析 ground truth 替换函数形式/系数。\n    rng = np.random.default_rng(seed)\n    if kind == 'rigid':\n        # 刚性族：低维唯一解 —— y = sin(πx)，解析确定，维数=1\n        X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n        y = np.sin(np.pi * X)\n        Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n        yv = np.sin(np.pi * Xv)\n        # 固定尺度归一：用稠密网格计算 std，与 w 无关\n        grid = np.linspace(0.02, 0.98, 400).reshape(-1, 1)\n        s = float(np.std(np.sin(np.pi * grid))) + 1e-9\n        y = y / s\n        yv = yv / s\n    else:\n        # 肥族：高维连续族 —— n 项随机多项式，自由度 n >> w，是 x 的函数\n        n = 20\n        coeffs = rng.standard_normal(n)          # (n,) 一维\n        X = rng.uniform(0.05, 0.95, (w, 1))      # (w,1)\n        y = (poly_basis(X, n) @ coeffs).reshape(-1, 1)\n        Xv = rng.uniform(0.02, 0.98, (200, 1))\n        yv = (poly_basis(Xv, n) @ coeffs).reshape(-1, 1)\n        # 用**固定稠密网格**定标(与 w 无关, 稳定), 让 y/yv 同尺度且 O(1)\n        grid = np.linspace(0.02, 0.98, 400).reshape(-1, 1)\n        s = float(np.std(poly_basis(grid, n) @ coeffs)) + 1e-9\n        y = y / s\n        yv = yv / s\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    return capacity_scan(family, seed=seed)"
    },
