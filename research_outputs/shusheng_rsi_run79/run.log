        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 100), 10) @ coeffs)
    if scale < 1e-10:
        scale = 1.0
    y = y / scale
    yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def mlp_fit(X, y, h, seeds=3):
    from scipy.optimize import minimize
    import numpy as np
    def forward(W1, b1, W2, b2, X):
        a1 = np.tanh(X @ W1 + b1)
        return a1 @ W2 + b2
    def loss_fn(params):
        W1 = params[:h*1].reshape(h, 1)
        b1 = params[h*1:h*1+h].reshape(h, 1)
        W2 = params[h*1+h:h*1+h*1].reshape(1, h)
        b2 = params[h*1+h*1:].reshape(1,)
        y_pred = forward(W1, b1, W2, b2, X)
        return np.mean((y_pred - y)**2)
    best_loss = np.inf
    best_params = None
    for s in range(seeds):
        rng = np.random.default_rng(s)
        W1 = rng.standard_normal((h, 1)) * 0.1
        b1 = rng.standard_normal((h, 1)) * 0.1
        W2 = rng.standard_normal((1, h)) * 0.1
        b2 = rng.standard_normal((1,)) * 0.1
        params0 = np.concatenate([W1.ravel(), b1.ravel(), W2.ravel(), b2.ravel()])
        res = minimize(loss_fn, params0, method='L-BFGS-B')
        if res.fun < best_loss:
            best_loss = res.fun
            best_params = res.x
    return {'params': best_params, 'h': h}

