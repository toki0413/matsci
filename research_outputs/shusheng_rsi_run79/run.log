import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = rng.standard_normal(4)
        X_poly = poly_basis(X, 2)
        y = X_poly @ coeffs[:2] + (X * X) @ coeffs[2:]
        y = y.reshape(-1, 1)
        Xv_poly = poly_basis(Xv, 2)
        yv = Xv_poly @ coeffs[:2] + (Xv * Xv) @ coeffs[2:]
        yv = yv.reshape(-1, 1)
        scale = np.std(np.concatenate([y, yv]))
        if scale > 1e-10:
            y /= scale
            yv /= scale
        return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}
    else:
        coeffs = rng.standard_normal(10)
        X_poly = poly_basis(X, 5)
        y = X_poly @ coeffs[:5] + (X * X) @ coeffs[5:]
        y = y.reshape(-1, 1)
        Xv_poly = poly_basis(Xv, 5)
        yv = Xv_poly @ coeffs[:5] + (Xv * Xv) @ coeffs[5:]
        yv = yv.reshape(-1, 1)
        scale = np.std(np.concatenate([y, yv]))
        if scale > 1e-10:
            y /= scale
            yv /= scale
        return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}


def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [1, 2, 3, 4]
    hs = list(range(1, 51))
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'score': 0.0}
    for w in ws:
        for kind in ['rigid', 'fat']:
            Nc = None
            for h in hs:
                data = family(kind, w, seed + w * h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.max(np.abs(pred - yv))
                if zero_violation(err):
                    if Nc is None:
                        Nc = h
                    break
