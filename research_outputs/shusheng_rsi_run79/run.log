import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 1000), 10) @ coeffs.reshape(-1, 1))
    if scale < 1e-10:
        scale = 1.0
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [4, 8, 16]
    hs = [4, 8, 16]
    summary = {'rigid': {}, 'fat': {}}
    objectives = {'rigid_min_Nc': 100.0, 'fat_Nc_undetectable': 0.0}
    for kind in ['rigid', 'fat']:
        summary[kind] = {}
        for w in ws:
            summary[kind][w] = {'Nc': None, 'errors': []}
            for h in hs:
                data = family(kind, w, seed + w*10 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.abs(pred - yv).max()
                summary[kind][w]['errors'].append((h, err))
                if zero_violation(err):
                    if summary[kind][w]['Nc'] is None or h < summary[kind][w]['Nc']:
                        summary[kind][w]['Nc'] = h
            nc = summary[kind][w]['Nc']
            if kind == 'rigid' and nc is not None:
                if nc < objectives['rigid_min_Nc']:
                    objectives['rigid_min_Nc'] = nc
            elif kind == 'fat' and nc is None:
                objectives['fat_Nc_undetectable'] += 1.0 / len(ws)
    return {'success': True, 'summary': summary, 'objectives': objective
