    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        y = np.sin(2 * np.pi * X) + 0.1 * np.sin(6 * np.pi * X)\n    else:\n        coeffs = rng.standard_normal(10)\n        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)\n    yv = np.sin(2 * np.pi * Xv) + 0.1 * np.sin(6 * np.pi * Xv) if kind == 'rigid' else poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)\n    scale = np.std(np.vstack([y, yv]))\n    if scale > 1e-10:\n        y /= scale\n        yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [5, 10, 20, 40]\n    hs = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_error': [], 'fat_error': []}\n    objectives = {'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        err_list = []\n        for w in ws:\n            min_Nc = None\n            best_err = float('inf')\n            for h in hs:\n                data = family(kind, w, seed + w * 100 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                yp = mlp_predict(model, Xv)\n                err = np.max(np.abs(yp - yv))\n                if zero_violation(err):\n                    if min_Nc is None or h < min_Nc:\n                        min_Nc = h\n                    if err < best_err:\n                        best_err = err\n                else:\n                    if err < best_err:\n                        best_err = err\n            Nc_list.append(min_Nc if min_Nc is not None else 100)\n            err_list.append(best_err)\n        summary[f'{kind}_Nc'].append(Nc_list)\n        summary[f'{kind}_error'].append(err_list)\n        rigid_finite = all(isinstance(n, (int, float)) and n < 50 for n in Nc_list)\n        objectives['score'] += 1.0 if rigid_finite else 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
