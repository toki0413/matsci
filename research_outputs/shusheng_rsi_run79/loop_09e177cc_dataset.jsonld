    {
      "@type": "PropertyValue",
      "name": "description",
      "value": "Implement a numerical experiment to test solution space rigidity in small MLPs. Define target function f(x) = sin(πx) on [-1, 1] with analytical constraints: values and first derivatives at w equally spaced points in [-1, 1]. Sweep hidden layer width N_c from 2 to 50, train MLPs to satisfy constraints using MSE loss with constraint penalties, measure max absolute error on 100 held-out points, record minimal N_c achieving violation ≤ 1e-3 for each w. Use early stopping (patience=50, max_epochs=500) and width sweep with fixed random seed."
    },
    {
      "@type": "PropertyValue",
      "name": "skill",
      "value": "None (custom ML experiment)"
    },
    {
      "@type": "PropertyValue",
      "name": "expected_prediction",
      "value": "The minimal width N_c(w) will remain bounded (rigid) for small w (≤ 5) but diverge exponentially as w increases (fat), demonstrating the transition from rigid to fat solution space in small networks."
    },
    {
      "@type": "PropertyValue",
      "name": "prediction_inputs"
    },
