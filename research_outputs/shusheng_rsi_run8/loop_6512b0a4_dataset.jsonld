      "value": "completed"
    },
    {
      "@type": "PropertyValue",
      "name": "success",
      "value": true
    },
    {
      "@type": "PropertyValue",
      "name": "result.rigid_support",
      "value": false
    },
    {
      "@type": "PropertyValue",
      "name": "objectives.score",
      "value": 0.015625
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 42))\n    rng = np.random.default_rng(seed)\n    w_list = [5, 10, 20, 40]\n    max_width = 64\n    hidden = 1\n    lr = 0.01\n    epochs = 500\n    objectives = {\"score\": 0.0}\n    summary = {\"Nc_vs_w\": [], \"rigid_support\": False}\n    \n    for w in w_list:\n        X = rng.uniform(-1, 1, (w, 1))\n        y = np.sin(np.pi * X) + 0.1 * rng.standard_normal((w, 1))\n        found = False\n        for width in range(2, max_width + 1):\n            W1 = rng.standard_normal((1, width)) * 0.5\n            b1 = rng.standard_normal((1, width)) * 0.5\n            W2 = rng.standard_normal((width, 1)) * 0.5\n            b2 = 0.0\n            for _ in range(epochs):\n                h = np.tanh(X @ W1 + b1)\n                y_pred = h @ W2 + b2\n                loss = ((y_pred - y) ** 2).mean()\n                if loss < 1e-4:\n                    found = True\n                    break\n                dL_dy = 2 * (y_pred - y) / y.size\n                dL_dW2 = h.T @ dL_dy\n                dL_db2 = np.sum(dL_dy, axis=0, keepdims=True)\n                dL_dh = dL_dy @ W2.T\n                dL_dh *= (1 - h ** 2)\n                dL_dW1 = X.T @ dL_dh\n                dL_db1 = np.sum(dL_dh, axis=0, keepdims=True)\n                W2 -= lr * dL_dW2\n                b2 -= lr * dL_db2\n                W1 -= lr * dL_dW1\n                b1 -= lr * dL_db1\n            if found:\n                summary[\"Nc_vs_w\"].append((w, width))\n                break\n        if not found:\n            summary[\"Nc_vs_w\"].append((w, max_width))\n    \n    Nc_vals = [wc for _, wc in summary[\"Nc_vs_w\"]]\n    increasing = all(Nc_vals[i] >= Nc_vals[i-1] for i in range(1, len(Nc_vals)))\n    if increasing:\n        objectives[\"score\"] = 1.0 / max(Nc_vals) if Nc_vals else 0.0\n        summary[\"rigid_support\"] = False\n    else:\n        objectives[\"score\"] = 1.0 / min(Nc_vals) if Nc_vals else 0.0\n        summary[\"rigid_support\"] = True\n    \n    return {\"success\": True, \"summary\": summary, \"objectives\": objectives}\n\ndef probe_author_probe(cfg):\n    return {\"note\": \"探针：通过扫描隐藏层宽度测量零违规所需最小容量，验证解空间刚性\"}"
    },
