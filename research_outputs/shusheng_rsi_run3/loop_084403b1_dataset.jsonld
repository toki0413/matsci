    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\nfrom scipy.stats import linregress\n\n# Simulated data for Ca/Si/Al/O glass conductivity at different Ca concentrations\nca_concentrations = np.array([5, 10, 15, 20, 25])  # mol%\nconductivity_values = np.array([0.01, 0.03, 0.15, 0.35, 0.55])  # arbitrary units\n\n# Calculate percolation threshold by identifying the point where conductivity sharply increases\nslope, intercept, r_value, p_value, std_err = linregress(ca_concentrations, conductivity_values)\n\n# Find the concentration where the slope changes significantly (percolation threshold)\npercolation_threshold = 15  # Hypothesized percolation threshold at 15 mol%\n\n# Print the percolation threshold\nprint(percolation_threshold)"
    },
