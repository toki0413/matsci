    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n# Simulated temperature-dependent diffusivity data for Ca-Si-Al-O glass\ntemperatures = np.array([1000, 1200, 1400, 1600, 1800])  # in Kelvin\ndiffusivities = np.array([1.2e-12, 3.5e-12, 9.8e-12, 2.4e-11, 5.6e-11])  # in m^2/s\n\n# Calculate activation energy using Arrhenius equation: D = D0 * exp(-Ea/(kT))\n# ln(D) = ln(D0) - Ea/(kT)\n# Using two points to estimate Ea\nk_boltzmann = 8.617333262145e-5  # eV/K\n\n# Select two temperatures for calculation (highest and lowest for better accuracy)\nT1, T2 = temperatures[0], temperatures[-1]\nD1, D2 = diffusivities[0], diffusivities[-1]\n\n# Arrhenius equation: ln(D2/D1) = (Ea/k) * (1/T1 - 1/T2)\nactivation_energy = k_boltzmann * np.log(D2 / D1) / (1/T1 - 1/T2)\n\nprint(f\"{activation_energy:.4f}\")"
    },
