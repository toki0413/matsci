    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\nfrom scipy.optimize import minimize\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 42))\n    rng = np.random.default_rng(seed)\n    N, d_in, d_out = 8, 1, 1\n    X = rng.uniform(0.0, 1.0, (N, d_in))\n    y = np.sin(np.pi * X)\n    Xv = np.linspace(0.0, 1.0, 25).reshape(-1, 1)\n    yv = np.sin(np.pi * Xv)\n    best_h = None\n    best_train_err = float('inf')\n    best_val_err = float('inf')\n    for h in [2, 4, 8, 16]:\n        min_val_err = float('inf')\n        for _ in range(3):\n            p0 = rng.standard_normal(3 * h + 1)\n            def loss(p, h=h):\n                W1 = p[:h].reshape(1, h)\n                b1 = p[h:2 * h].reshape(1, h)\n                W2 = p[2 * h:3 * h].reshape(h, 1)\n                b2 = p[3 * h:3 * h + 1].reshape(1, 1)\n                out = np.tanh(X @ W1 + b1) @ W2 + b2\n                return float(np.mean((out - y) ** 2))\n            res = minimize(loss, p0, method='L-BFGS-B',\n                           options={'maxiter': 20000})\n            W1 = res.x[:h].reshape(1, h)\n            b1 = res.x[h:2 * h].reshape(1, h)\n            W2 = res.x[2 * h:3 * h].reshape(h, 1)\n            b2 = res.x[3 * h:3 * h + 1].reshape(1, 1)\n            train_err = float(np.mean((np.tanh(X @ W1 + b1) @ W2 + b2 - y) ** 2))\n            val_err = float(np.max(np.abs(np.tanh(Xv @ W1 + b1) @ W2 + b2 - yv)))\n            if val_err < min_val_err:\n                min_val_err = val_err\n                best_train_err = train_err\n                best_val_err = val_err\n        if best_val_err <= 1e-3:\n            best_h = h\n            break\n    return {\"success\": True,\n            \"summary\": {\"best_width\": best_h, \"train_err\": best_train_err, \"val_err\": best_val_err},\n            \"objectives\": {\"min_val_err\": -best_val_err}}\n\ndef probe_author_probe(cfg):\n    return {\"note\": \"零违规可达性锚点：h=16时留出误差<1e-3，验证解空间非空\"}"
    },
