        y_exact = np.exp(-X.flatten())
        y = y_exact.reshape(-1, 1)
        yv = np.exp(-Xv.flatten()).reshape(-1, 1)
    elif kind == 'fat':
        coeffs = rng.standard_normal(10)
        y = poly_basis(X, 10) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 10) @ coeffs.reshape(-1, 1)
    else:
        y = np.zeros((w, 1))
        yv = np.zeros((200, 1))
    scale = np.std(np.vstack([y.flatten(), yv.flatten()]))
    if scale == 0: scale = 1.0
    y /= scale
    yv /= scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}

