import numpy as np

def family(kind, w, seed):
    rng = np.random.default_rng(seed)
    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)
    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)
    if kind == 'rigid':
        coeffs = np.array([1.0, -2.0, 1.0])
        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)
    else:
        coeffs = rng.standard_normal(50)
        y = poly_basis(X, 50) @ coeffs.reshape(-1, 1)
        yv = poly_basis(Xv, 50) @ coeffs.reshape(-1, 1)
    scale = np.std(poly_basis(np.linspace(0, 1, 100), 50) @ coeffs)
    if scale > 1e-10:
        y = y / scale
        yv = yv / scale
    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}


def run(cfg):
    seed = int(cfg.get('seed', 0))
    ws = [4, 8, 16, 32]
    hs = [2, 4, 8, 16, 32]
    summary = {'rigid_Nc': [], 'fat_Nc': []}
    objectives = {'rigid_rigid_ratio': 0.0, 'fat_fat_ratio': 0.0}
    for kind in ['rigid', 'fat']:
        Nc_list = []
        for w in ws:
            Nc_found = None
            for h in hs:
                data = family(kind, w, seed + w * 100 + h)
                X, y = data['X'], data['y']
                Xv, yv = data['Xv'], data['yv']
                model = mlp_fit(X, y, h, seeds=3)
                pred = mlp_predict(model, Xv)
                err = np.max(np.abs(pred - yv))
                if err <= 1e-3:
                    Nc_found = h
                    break
            if Nc_found is None:
                Nc_found = 1000.0
            Nc_list.append(float(Nc_found))
        summary[kind + '_Nc'] = Nc_list
        avg_Nc = np.mean(Nc_list)
        if kind == 'rigid':
            objectives['rigid_rigid_ratio'] = float(avg_Nc / min(ws))
        else:
            objectives['fat_fat_ratio'] = float(avg_Nc / max(ws))
    return {'success': True, 'summary': summary, 'objectives': objectives}
