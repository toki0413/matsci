    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([1.0, -2.0, 1.0])\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    else:\n        coeffs = rng.standard_normal(3)\n        y = poly_basis(X, 3) @ coeffs.reshape(-1, 1)\n        yv = poly_basis(Xv, 3) @ coeffs.reshape(-1, 1)\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    w_list = [3, 5, 7, 9]\n    h_list = [4, 8, 16, 32]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': [], 'fat_errors': []}\n    objectives = {'score': 0.0, 'rigid_max_Nc': 0.0, 'fat_max_Nc': 0.0}\n    scale = np.std(poly_basis(np.linspace(0, 1, 100), 3) @ np.random.default_rng(0).standard_normal(3))\n    for kind in ['rigid', 'fat']:\n        for w in w_list:\n            Nc = None\n            errors = []\n            for h in h_list:\n                data = family(kind, w, seed + w + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                y_norm = y / scale\n                yv_norm = yv / scale\n                model = mlp_fit(X, y_norm, h, seeds=3)\n                yv_pred = mlp_predict(model, Xv)\n                err = float(np.max(np.abs(yv_pred - yv_norm)))\n                errors.append(err)\n                if err <= 1e-3 and Nc is None:\n                    Nc = h\n            if Nc is None:\n                Nc = max(h_list)\n            summary[f'{kind}_Nc'].append(Nc)\n            summary[f'{kind}_errors'].append(errors)\n            if kind == 'rigid':\n                objectives['rigid_max_Nc'] = max(objectives['rigid_max_Nc'], float(Nc))\n            else:\n                objectives['fat_max_Nc'] = max(objectives['fat_max_Nc'], float(Nc))\n            objectives['score'] += 1.0 / (1.0 + Nc)\n    objectives['score'] /= len(w_list) * 2\n    summary['note'] = 'rigid: Nc稳定小值; fat: Nc达上限'\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
