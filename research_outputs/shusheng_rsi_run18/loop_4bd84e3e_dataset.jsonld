      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n# Mock implementation of the bootstrap feasibility check and width scan\ndef optimize_with_lbfgsb(width, seed):\n    # Simulated optimization result (in practice, this would involve actual optimization)\n    np.random.seed(seed)\n    # Simulate some cost function value that depends on width and seed\n    return np.random.rand() * width\n\ndef bootstrap_feasibility_check():\n    # Step 0: Check if zero-violation is reachable\n    for _ in range(10):  # Multiple starts\n        result = optimize_with_lbfgsb(width=1, seed=42)\n        if result < 0.1:  # Arbitrary threshold for feasibility\n            return True\n    return False\n\ndef width_scan(h_max=50):\n    N_c_w = {}\n    for w in range(1, h_max + 1):\n        N_c_w[w] = []\n        for seed in range(5):  # Multiple random seeds\n            result = optimize_with_lbfgsb(width=w, seed=seed)\n            N_c_w[w].append(result)\n    return N_c_w\n\n# Perform feasibility check\nfeasible = bootstrap_feasibility_check()\nprint(f\"Feasibility Check: {'Reachable' if feasible else 'Not Reachable'}\")\n\n# Perform width scan\nN_c_w_table = width_scan()\nfor w, values in N_c_w_table.items():\n    print(f\"Width {w}: Mean N_c = {np.mean(values):.4f}\")"
