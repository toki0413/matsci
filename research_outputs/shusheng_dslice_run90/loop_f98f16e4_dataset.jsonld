    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = rng.standard_normal(5)\n        y = poly_basis(X, 5) @ coeffs.reshape(1, -1).T\n        yv = poly_basis(Xv, 5) @ coeffs.reshape(1, -1).T\n    elif kind == 'fat':\n        coeffs = rng.standard_normal(50)\n        y = poly_basis(X, 50) @ coeffs.reshape(1, -1).T\n        yv = poly_basis(Xv, 50) @ coeffs.reshape(1, -1).T\n    else:\n        y = np.zeros((w, 1))\n        yv = np.zeros((200, 1))\n    scale = np.std(np.concatenate([y, yv]))\n    if scale > 0:\n        y /= scale\n        yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [4, 8, 16, 32]\n    hs = [4, 8, 16, 32, 64]\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_err': [], 'fat_err': []}\n    objectives = {'rigid_score': 0.0, 'fat_score': 0.0, 'score': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_list = []\n        err_list = []\n        for w in ws:\n            best_Nc = 999.0\n            min_err = 1e9\n            for h in hs:\n                data = family(kind, w, seed + w * 1000 + h)\n                X, y = data['X'], data['y']\n                Xv, yv = data['Xv'], data['yv']\n                model = mlp_fit(X, y, h, seeds=3)\n                pred = mlp_predict(model, Xv)\n                err = float(np.max(np.abs(pred - yv)))\n                is_zero = zero_violation(err)\n                if is_zero and h < best_Nc:\n                    best_Nc = float(h)\n                if err < min_err:\n                    min_err = err\n            Nc_list.append(best_Nc if best_Nc < 999 else 999.0)\n            err_list.append(min_err)\n        summary[f'{kind}_Nc'].append(Nc_list)\n        summary[f'{kind}_err'].append(err_list)\n        if kind == 'rigid':\n            if all(n < 999 for n in Nc_list):\n                objectives['rigid_score'] = 1.0\n            else:\n                objectives['rigid_score'] = 0.0\n        else:\n            if all(n >= 999 for n in Nc_list):\n                objectives['fat_score'] = 1.0\n            else:\n                objectives['fat_score'] = 0.0\n    objectives['score'] = (objectives['rigid_score'] + objectives['fat_score']) / 2.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
