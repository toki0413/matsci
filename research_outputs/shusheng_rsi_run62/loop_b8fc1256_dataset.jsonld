    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef family(kind, w, seed):\n    rng = np.random.default_rng(seed)\n    X = np.linspace(0.05, 0.95, w).reshape(-1, 1)\n    Xv = np.linspace(0.02, 0.98, 200).reshape(-1, 1)\n    if kind == 'rigid':\n        coeffs = np.array([0.0, np.pi, 0.1])\n        y = np.sin(np.pi * X) + 0.1 * X**2\n        yv = np.sin(np.pi * Xv) + 0.1 * Xv**2\n    else:\n        n = 20\n        coeffs = rng.standard_normal(n)\n        X_poly = poly_basis(X, n)\n        Xv_poly = poly_basis(Xv, n)\n        y = (X_poly @ coeffs).reshape(-1, 1)\n        yv = (Xv_poly @ coeffs).reshape(-1, 1)\n    scale = np.std(np.concatenate([y, yv]))\n    if scale > 1e-10:\n        y /= scale; yv /= scale\n    return {'X': X, 'y': y, 'Xv': Xv, 'yv': yv}\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    ws = [10, 20]\n    H_range = list(range(1, 21))\n    summary = {'rigid_Nc': [], 'fat_Nc': [], 'rigid_errors': [], 'fat_errors': []}\n    objectives = {'rigid_rigidity': 0.0, 'fat_rigidity': 0.0}\n    for kind in ['rigid', 'fat']:\n        Nc_w = {}\n        all_errors = []\n        for w in ws:\n            w_errors = []\n            for h in H_range:\n                err_list = []\n                for s in range(1):\n                    data = family(kind, w, seed + s)\n                    X, y = data['X'], data['y']\n                    Xv, yv = data['Xv'], data['yv']\n                    model = mlp_fit(X, y, h, seeds=1)\n                    yp = mlp_predict(model, Xv)\n                    err = np.max(np.abs(yp - yv))\n                    err_list.append(err)\n                    if err <= 1e-3:\n                        w_errors.append(h)\n                        break\n                if not w_errors:\n                    w_errors.append(999)\n            min_Nc = min(w_errors)\n            Nc_w[w] = min_Nc\n            all_errors.append(w_errors)\n        summary[f'{kind}_Nc'] = [Nc_w[w] for w in ws]\n        summary[f'{kind}_errors'] = all_errors\n        if kind == 'rigid':\n            bounded = all(N <= 20 for N in Nc_w.values())\n            objectives['rigid_rigidity'] = 1.0 if bounded else 0.0\n        else:\n            all_none = all(N >= 999 for N in Nc_w.values())\n            objectives['fat_rigidity'] = 1.0 if all_none else 0.0\n    return {'success': True, 'summary': summary, 'objectives': objectives}"
    },
