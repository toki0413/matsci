    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    n_max = int(cfg.get('n_max', 10))\n    tol = float(cfg.get('tol', 1e-6))\n    a = float(rng.normal(0.0, 1.0))\n    b = float(rng.normal(0.0, 1.0))\n    c = float(rng.normal(0.0, 1.0))\n    lhs = a ** 3 + b ** 3 + c ** 3 - 3.0 * a * b * c\n    s1 = a + b + c\n    s2 = a * b + b * c + c * a\n    rhs = s1 * (s1 * s1 - 3.0 * s2)\n    rel_err = float(abs(lhs - rhs) / (abs(rhs) + 1e-300))\n    converged = rel_err < tol\n    trajectories = []\n    for k in range(n_max):\n        scale = 1.0 - 0.1 * float(k)\n        trajectories.append(float(abs(lhs * scale - rhs * scale)))\n    return {\"success\": converged,\n            \"summary\": {\"note\": \"three-number identity residual trajectory\",\n                        \"a\": float(a), \"b\": float(b), \"c\": float(c),\n                        \"lhs\": float(lhs), \"rhs\": float(rhs),\n                        \"rel_err\": rel_err, \"steps\": int(n_max)},\n            \"objectives\": {\"score\": float(rel_err),\n                           \"converged\": 1.0 if converged else 0.0,\n                           \"final_residual\": float(trajectories[-1])}}"
    },
