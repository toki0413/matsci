      "value": 6.324555358240311e-12
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    x = np.linspace(-20.0, 20.0, 2048)\n    t = float(cfg.get('t_max', 10.0))\n    beta = float(cfg.get('beta', 1.0))\n    phases = rng.uniform(0.0, 2.0 * np.pi, size=10)\n    floors = []\n    for k in range(10):\n        phi = phases[k]\n        exact = 1.0 / np.cosh(x - t) * np.exp(1j * (0.5 * (x - t) + phi))\n        pert = exact + 1e-12 * np.exp(1j * (x + phi))\n        diff = np.abs(pert - exact)\n        l2 = float(np.sqrt(np.trapezoid(diff ** 2, x)))\n        floors.append(l2)\n    l2_arr = np.array(floors)\n    max_l2 = float(np.max(l2_arr))\n    mean_l2 = float(np.mean(l2_arr))\n    return {\"success\": max_l2 < 1e-6,\n            \"summary\": {\"note\": \"phase-shift L2 floor trajectory\",\n                        \"max_l2\": max_l2,\n                        \"mean_l2\": mean_l2,\n                        \"per_step\": [float(v) for v in l2_arr]},\n            \"objectives\": {\"score\": 1.0 - min(1.0, max_l2 / 1e-6),\n                           \"l2_max\": max_l2,\n                           \"l2_mean\": mean_l2}}"
    },
