    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    L = 40.0\n    x_max = 20.0\n    check_times = [0.0, 2.0, 5.0, 10.0]\n    v = 0.5\n    x0 = 0.0\n    phi0 = 0.0\n\n    def exact_sol(x, t):\n        arg = x - v * t\n        ph = v * x + (0.5 - 0.25 * v * v) * t\n        return 1.0 / np.cosh(arg) * np.exp(1j * ph)\n\n    def symbolic_check():\n        xs = np.linspace(-8, 8, 801)\n        h = 1e-5\n        psi = exact_sol(xs, 0.0)\n        psix_p = (exact_sol(xs + h, 0.0) - exact_sol(xs, 0.0)) / h\n        psix_m = (exact_sol(xs, 0.0) - exact_sol(xs - h, 0.0)) / h\n        psix = 0.5 * (psix_p + psix_m)\n        psixx_p = (psix.reshape(-1, 1) + h - psix.reshape(-1, 1)) / h\n        psixx_m = (psix.reshape(-1, 1) - psix.reshape(-1, 1) - h) / h\n        psixx = 0.5 * (psixx_p + psixx_m)\n        psit_p = (exact_sol(xs, h) - exact_sol(xs, 0.0)) / h\n        psit_m = (exact_sol(xs, 0.0) - exact_sol(xs, -h)) / h\n        psit = 0.5 * (psit_p + psit_m)\n        lhs = 1j * psit + 0.5 * psixx + np.abs(psi) ** 2 * psi\n        return float(np.max(np.abs(lhs)))\n\n    def mass(u, dx):\n        return float(np.sum(np.abs(u) ** 2) * dx)\n\n    def energy(u, dx, k):\n        ux = np.fft.ifft(1j * k * np.fft.fft(u))\n        return float((np.sum(np.abs(ux) ** 2) - 0.5 * np.sum(np.abs(u) ** 4)) * dx)\n\n    def momentum(u, dx, k):\n        ux = np.fft.ifft(1j * k * np.fft.fft(u))\n        return float(np.sum(np.imag(np.conj(u) * ux)) * dx)\n\n    def split_step(Nx, Nt, T_max):\n        dx = L / Nx\n        x = np.linspace(-x_max, x_max - dx, Nx)\n        dt = T_max / Nt\n        k = 2.0 * np.pi * np.fft.fftfreq(Nx, d=dx)\n        u = exact_sol(x, 0.0).astype(np.complex128)\n        half_dt = 0.5 * dt\n        records = []\n        next_idx = 0\n        for step in range(Nt + 1):\n            t_cur = step * dt\n            while next_idx < len(check_times) and abs(t_cur - check_times[next_idx]) < 1e-9:\n                rec = {\"t\": float(t_cur),\n                       \"l2\": float(np.linalg.norm(u - exact_sol(x, t_cur)) * np.sqrt(dx)),\n                       \"mass\": mass(u, dx),\n                       \"energy\": energy(u, dx, k),\n                       \"momentum\": momentum(u, dx, k)}\n                records.append(rec)\n                next_idx += 1\n            if step == Nt:\n                break\n            u = u * np.exp(1j * half_dt * np.abs(u) ** 2)\n            u = np.fft.ifft(np.exp(-0.5 * 1j * k ** 2 * dt) * np.fft.fft(u))\n            u = u * np.exp(1j * half_dt * np.abs(u) ** 2)\n        return records\n\n    def mesh_refinement():\n        base = [(32, 64), (64, 128), (128, 256)]\n        errs = []\n        for Nx, Nt in base:\n            recs = split_step(Nx, Nt, 10.0)\n            errs.append(recs[-1][\"l2\"])\n        orders = []\n        for i in range(1, len(errs)):\n            if errs[i - 1] > 1e-30:\n                orders.append(np.log(errs[i - 1] / errs[i]) / np.log(2.0))\n        return errs, orders\n\n    sym_err = symbolic_check()\n    recs = split_step(128, 512, 10.0)\n    errs, orders = mesh_refinement()\n    mass0 = recs[0][\"mass\"]\n    energy0 = recs[0][\"energy\"]\n    mom0 = recs[0][\"momentum\"]\n    mass_drift = max(abs(r[\"mass\"] - mass0) / max(abs(mass0), 1e-30) for r in recs)\n    energy_drift = max(abs(r[\"energy\"] - energy0) / max(abs(energy0), 1e-30) for r in recs)\n    mom_drift = max(abs(r[\"momentum\"] - mom0) / max(abs(mom0), 1e-30) for r in recs)\n    return {\"success\": True,\n            \"summary\": {\"symbolic_residual\": sym_err,\n                        \"final_l2\": recs[-1][\"l2\"],\n                        \"mass_drift\": mass_drift,\n                        \"energy_drift\": energy_drift,\n                        \"momentum_drift\": mom_drift,\n                        \"refinement_errors\": errs,\n                        \"convergence_orders\": orders},\n            \"objectives\": {\"score\": float(recs[-1][\"l2\"])}}"
    },
    {
