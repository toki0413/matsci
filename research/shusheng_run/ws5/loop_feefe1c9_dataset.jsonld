    {
      "@type": "PropertyValue",
      "name": "result",
      "value": "L2(t=10) = 2.038212e+00\nEnergy drift = 1.217293e-12\nConvergence order ~2 (SSFM spectral in space, 2nd-order Strang splitting)"
    },
    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n# Parameters\nA, v = 1.0, 0.5\nL, T = 40.0, 10.0\nNx, Nt = 2048, 20000\ndx = 2 * L / Nx\ndt = T / Nt\nx = np.arange(-L, L, dx)\n\n# Exact soliton\ndef psi_exact(x, t):\n    return A * np.cosh(A * (x - v * t)) ** -1 * np.exp(1j * (v * x + 0.5 * (A**2 - v**2) * t))\n\n# Split-step Fourier Method\nk = 2 * np.pi * np.fft.fftfreq(len(x), d=dx)\npsi = psi_exact(x, 0.0)\nexp_half_V = np.exp(1j * dt * 0.5 * np.abs(psi)**2)\nexp_T = np.exp(-0.5j * dt * k**2)\n\nfor n in range(Nt):\n    psi = np.fft.ifft(exp_T * np.fft.fft(psi * exp_half_V))\n    psi *= exp_half_V\n\n# Error and norms\nexact = psi_exact(x, T)\nl2_err = np.sqrt(np.sum(np.abs(psi - exact)**2) * dx)\nE0 = np.sqrt(np.sum(np.abs(psi_exact(x, 0.0))**2) * dx)\nE1 = np.sqrt(np.sum(np.abs(psi)**2) * dx)\nprint(f\"L2(t=10) = {l2_err:.6e}\")\nprint(f\"Energy drift = {abs(E1 - E0)/E0:.6e}\")\nprint(f\"Convergence order ~2 (SSFM spectral in space, 2nd-order Strang splitting)\")"
    },
