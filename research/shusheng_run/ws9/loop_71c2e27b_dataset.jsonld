    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    L = float(cfg.get('L', 20.0))\n    nx = int(cfg.get('nx', 512))\n    tmax = float(cfg.get('tmax', 10.0))\n    nt = int(cfg.get('nt', 20000))\n    x = np.linspace(-L / 2, L / 2, nx, endpoint=False)\n    dx = x[1] - x[0]\n    dt = tmax / nt\n    k = 2 * np.pi * np.fft.fftfreq(nx, d=dx)\n    k2 = k ** 2\n    amp = float(cfg.get('amplitude', 1.0))\n    v = float(cfg.get('velocity', 0.0))\n    x0 = float(cfg.get('x0', 0.0))\n    phase = float(cfg.get('phase', 0.0))\n    psi0 = amp * np.cosh(-amp * (x - x0)) ** -1 * np.exp(1j * (v * (x - x0) / 2 + phase))\n\n    def exact(t, xc):\n        return amp * np.cosh(-amp * (x - xc)) ** -1 * np.exp(\n            1j * (v * (x - xc) / 2 + phase + (amp ** 2 - v ** 2 / 4) * t))\n\n    def mass(p):\n        return float(np.real(np.sum(np.abs(p) ** 2) * dx))\n\n    def energy(p):\n        px = np.fft.ifft(1j * k * np.fft.fft(p))\n        return float(np.real(np.sum((np.abs(px) ** 2 - np.abs(p) ** 4) * dx)) / 2)\n\n    def momentum(p):\n        px = np.fft.ifft(1j * k * np.fft.fft(p))\n        return float(np.real(np.sum(np.imag(np.conj(p) * px) * dx)))\n\n    def l2(p, q):\n        return float(np.sqrt(np.sum(np.abs(p - q) ** 2) * dx))\n\n    def step_ss(p):\n        n2 = 2 * np.abs(p) ** 2\n        return p * np.exp(-1j * n2 * dt)\n\n    def step_fd1(p):\n        lap = (np.roll(p, 1) - 2 * p + np.roll(p, -1)) / dx ** 2\n        return p + 1j * dt * (lap + 2 * np.abs(p) ** 2 * p)\n\n    def step_fd2(p):\n        lap = (np.roll(p, 1) - 2 * p + np.roll(p, -1)) / dx ** 2\n        return p + 1j * dt * (lap + 2 * np.abs(p) ** 2 * p) - 0.5 * dt ** 2 * (\n            (np.roll(lap, 1) - 2 * lap + np.roll(lap, -1)) / dx ** 2 +\n            2 * (2 * np.abs(p) ** 2 * lap + p * np.conj(p) * lap +\n                 np.conj(p) * lap * p + p * np.abs(lap) ** 2))\n\n    def step_split(p):\n        p = p * np.exp(-0.5j * dt * k2)\n        p = np.fft.ifft(np.fft.fft(p) * np.exp(-1j * 2 * np.abs(np.fft.ifft(np.fft.fft(p))) ** 2 * dt))\n        return p * np.exp(-0.5j * dt * k2)\n\n    methods = {\n        \"symplectic_split\": step_split,\n        \"ss_first_order\": step_ss,\n        \"fd_euler\": step_fd1,\n        \"fd_taylor\": step_fd2\n    }\n\n    e0 = energy(psi0)\n    p0 = momentum(psi0)\n    m0 = mass(psi0)\n    track = {m: {\"err\": [], \"energy\": [], \"mom\": [], \"mass\": []} for m in methods}\n    times = np.linspace(0, tmax, nt + 1)\n    ps = {m: psi0.copy() for m in methods}\n\n    for n in range(nt + 1):\n        t = times[n]\n        xc = x0 + v * t\n        ref = exact(t, xc)\n        for mname, step in methods.items():\n            p = ps[mname]\n            track[mname][\"err\"].append(l2(p, ref))\n            track[mname][\"energy\"].append(energy(p))\n            track[mname][\"mom\"].append(momentum(p))\n            track[mname][\"mass\"].append(mass(p))\n            if n < nt:\n                ps[mname] = step(p)\n\n    def rel(a, b):\n        return float(abs(a - b) / max(abs(b), 1e-300))\n\n    results = {}\n    for mname in methods:\n        err = np.array(track[mname][\"err\"])\n        en = np.array(track[mname][\"energy\"])\n        mo = np.array(track[mname][\"mom\"])\n        ma = np.array(track[mname][\"mass\"])\n        results[mname] = {\n            \"max_l2\": float(np.max(err)),\n            \"final_l2\": float(err[-1]),\n            \"energy_rel\": rel(float(en[-1]), e0),\n            \"mom_rel\": rel(float(mo[-1]), p0),\n            \"mass_rel\": rel(float(ma[-1]), m0),\n            \"drift_l2\": float(np.max(np.abs(err - err[0]))),\n            \"energy_range\": float(np.max(np.abs(en - en[0]))),\n            \"mom_range\": float(np.max(np.abs(mo - mo[0])))\n        }\n\n    tol_l2 = float(cfg.get(\"tol_l2\", 1e-6))\n    tol_e = float(cfg.get(\"tol_energy\", 1e-8))\n    tol_p = float(cfg.get(\"tol_momentum\", 1e-7))\n    ok = {}\n    for mname, r in results.items():\n        ok[mname] = bool(r[\"max_l2\"] < tol_l2 and r[\"energy_rel\"] < tol_e and r[\"mom_rel\"] < tol_p)\n\n    def symmetry_metric(r):\n        return float(r[\"final_l2\"] + 1e3 * r[\"energy_rel\"] + 1e3 * r[\"mom_rel\"])\n\n    scores = {m: symmetry_metric(r) for m, r in results.items()}\n    best = min(scores, key=scores.get)\n    worst = max(scores, key=scores.get)\n\n    summary = {\n        \"note\": \"Four-method NLSE symmetry-adapted error metric benchmark\",\n        \"tol_l2\": tol_l2,\n        \"tol_energy\": tol_e,\n        \"tol_momentum\": tol_p,\n        \"best_method\": best,\n        \"worst_method\": worst,\n        \"mass_initial\": m0,\n        \"energy_initial\": e0,\n        \"momentum_initial\": p0\n    }\n    for mname in methods:\n        summary[mname + \"_ok\"] = ok[mname]\n        summary[mname + \"_max_l2\"] = results[mname][\"max_l2\"]\n        summary[mname + \"_final_l2\"] = results[mname][\"final_l2\"]\n        summary[mname + \"_energy_rel\"] = results[mname][\"energy_rel\"]\n        summary[mname + \"_mom_rel\"] = results[mname][\"mom_rel\"]\n        summary[mname + \"_score\"] = scores[mname]\n\n    objectives = {\n        \"score\": float(-scores[best]),\n        \"best_l2\": float(results[best][\"final_l2\"]),\n        \"energy_violation\": float(np.max([results[m][\"energy_rel\"] for m in methods])),\n        \"momentum_violation\": float(np.max([results[m][\"mom_rel\"] for m in methods])),\n        \"methods_passing\": float(sum(ok.values())),\n        \"worst_l2\": float(results[worst][\"max_l2\"]),\n        \"symmetry_metric_best\": float(scores[best]),\n        \"symmetry_metric_worst\": float(scores[worst])\n    }\n\n    return {\"success\": True, \"summary\": summary, \"objectives\": objectives}"
    },
    {
      "@type": "PropertyValue",
      "name": "reproducible",
      "value": true
    }
  ],
