    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    L = 40.0\n    N = 2048\n    dx = L / N\n    x = np.linspace(-L / 2, L / 2 - dx, N)\n    dt = cfg.get('dt', 0.001)\n    t_max = cfg.get('t_max', 10.0)\n    nsteps = int(round(t_max / dt))\n    bits_list = cfg.get('bits_list', [16, 24, 32, 53])\n    k = 2.0 * np.pi * np.fft.fftfreq(N, d=dx)\n    psi = np.cosh(x) ** (-1.0)\n    psi = psi / np.sqrt(np.sum(np.abs(psi) ** 2) * dx)\n\n    def energy(psi_val):\n        grad = np.gradient(psi_val, dx)\n        return (np.sum(np.abs(grad) ** 2) - 0.5 * np.sum(np.abs(psi_val) ** 4)) * dx\n\n    def momentum(psi_val):\n        grad = np.gradient(psi_val, dx)\n        return np.real(np.sum(np.conj(psi_val) * grad)) * dx\n\n    e0 = energy(psi)\n    p0 = momentum(psi)\n    psi_ref = np.cosh(x) ** (-1.0)\n    psi_ref = psi_ref / np.sqrt(np.sum(np.abs(psi_ref) ** 2) * dx)\n    phase_ref = np.angle(np.vdot(psi_ref, psi))\n    psi = psi * np.exp(-1j * phase_ref)\n    for _ in range(nsteps):\n        psi = psi * np.exp(0.5j * dt * np.abs(psi) ** 2)\n        psi = np.fft.ifft(np.exp(-0.5j * dt * k ** 2) * np.fft.fft(psi))\n        psi = psi * np.exp(0.5j * dt * np.abs(psi) ** 2)\n    l2_err = np.sqrt(np.sum(np.abs(psi - psi_ref) ** 2) * dx)\n    e1 = energy(psi)\n    p1 = momentum(psi)\n    e_drift = abs(e1 - e0) / max(abs(e0), 1e-30)\n    p_drift = abs(p1 - p0) / max(abs(p0), 1e-30)\n    long_steps = 20000\n    tau_vals = [1, 10, 50, 100, 200, 500]\n    diffusion = {}\n    for b in bits_list:\n        psi_t = np.cosh(x) ** (-1.0)\n        psi_t = psi_t / np.sqrt(np.sum(np.abs(psi_t) ** 2) * dx)\n        phase_ref = np.angle(np.vdot(psi_ref, psi_t))\n        psi_t = psi_t * np.exp(-1j * phase_ref)\n        phis = np.zeros(long_steps + 1, dtype=np.float64)\n        phis[0] = np.angle(np.vdot(psi_ref, psi_t))\n        for n in range(1, long_steps + 1):\n            psi_t = psi_t * np.exp(0.5j * dt * np.abs(psi_t) ** 2)\n            psi_t = np.fft.ifft(np.exp(-0.5j * dt * k ** 2) * np.fft.fft(psi_t))\n            psi_t = psi_t * np.exp(0.5j * dt * np.abs(psi_t) ** 2)\n            re = np.sign(np.real(psi_t)) * np.floor(np.abs(np.real(psi_t)) * (2.0 ** b)) / (2.0 ** b)\n            im = np.sign(np.imag(psi_t)) * np.floor(np.abs(np.imag(psi_t)) * (2.0 ** b)) / (2.0 ** b)\n            psi_t = re + 1j * im\n            phis[n] = np.angle(np.vdot(psi_ref, psi_t))\n        phis = np.unwrap(phis)\n        inc = {t: np.diff(phis[::t]) for t in tau_vals}\n        var = {t: float(np.var(inc[t])) for t in tau_vals}\n        slope = float(np.polyfit(np.log(np.array([float(t) for t in tau_vals])),\n                                 np.log(np.array([var[t] for t in tau_vals])), 1)[0])\n        sk = {t: float((np.mean((inc[t] - np.mean(inc[t])) ** 3) /\n                        (np.std(inc[t]) ** 3 + 1e-30))) for t in tau_vals}\n        ku = {t: float((np.mean((inc[t] - np.mean(inc[t])) ** 4) /\n                        (np.std(inc[t]) ** 4 + 1e-30)) - 3.0) for t in tau_vals}\n        diffusion[str(b)] = {\"variance_slope\": slope,\n                             \"variances\": {str(t): var[t] for t in tau_vals},\n                             \"skewness\": {str(t): sk[t] for t in tau_vals},\n                             \"excess_kurtosis\": {str(t): ku[t] for t in tau_vals}}\n    objectives = {\"l2_error\": float(l2_err),\n                  \"energy_drift\": float(e_drift),\n                  \"momentum_drift\": float(p_drift),\n                  \"base_solver_pass\": float(1.0 if (l2_err < 1e-6 and e_drift < 1e-8 and p_drift < 1e-7) else 0.0)}\n    for b in diffusion:\n        objectives[\"diff_slope_bits_\" + b] = float(diffusion[b][\"variance_slope\"])\n    return {\"success\": True,\n            \"summary\": {\"note\": \"split-step NLSE solver with roundoff phase diffusion\",\n                        \"l2_error_at_t10\": float(l2_err),\n                        \"energy_drift\": float(e_drift),\n                        \"momentum_drift\": float(p_drift),\n                        \"diffusion_results\": diffusion},\n            \"objectives\": objectives}"
    },
