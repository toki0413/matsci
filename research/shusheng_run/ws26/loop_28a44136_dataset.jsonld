    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    steps = int(cfg.get('steps', 200))\n    scale = float(cfg.get('scale', 1.0))\n    traj = np.zeros(steps, dtype=float)\n    for k in range(steps):\n        t = k / max(steps - 1, 1)\n        base = np.sin(2.0 * np.pi * t) * np.exp(-t)\n        noise = rng.normal(0.0, 0.05)\n        traj[k] = base + noise * scale\n    last = float(traj[-1]) if steps > 0 else 0.0\n    mean = float(np.mean(traj)) if steps > 0 else 0.0\n    return {\"success\": True,\n            \"summary\": {\"note\": \"sin*exp damped trajectory with scaled gaussian noise\",\n                        \"steps\": steps,\n                        \"scale\": scale,\n                        \"last_value\": last,\n                        \"mean_value\": mean},\n            \"objectives\": {\"score\": abs(last) + 0.01 * mean}}"
    },
