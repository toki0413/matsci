    {
      "@type": "PropertyValue",
      "name": "script",
      "value": "import numpy as np\n\n\ndef run(cfg):\n    seed = int(cfg.get('seed', 0))\n    rng = np.random.default_rng(seed)\n    L = float(cfg.get('L', 40.0))\n    nx = int(cfg.get('nx', 512))\n    nt = int(cfg.get('nt', 1000))\n    tmax = float(cfg.get('tmax', 10.0))\n    A = float(cfg.get('A', 1.0))\n    B = A\n    dx = L / nx\n    x = np.linspace(-L / 2, L / 2, nx, endpoint=False)\n    dt = tmax / nt\n    tgrid = np.linspace(0.0, tmax, nt + 1)\n    k = 2.0 * np.pi * np.fft.fftfreq(nx, d=dx)\n\n    def analytic(x, t):\n        phase = 1j * (0.5 * t)\n        return A * np.cosh(B * (x)) ** (-1) * np.exp(phase)\n\n    psi0 = A * np.cosh(B * x) ** (-1)\n\n    def ssfm_step(psi, dt):\n        half = 0.5 * dt\n        p1 = np.fft.fft(psi) * np.exp(-0.5j * k ** 2 * half)\n        m1 = np.fft.ifft(p1)\n        m1 = m1 * np.exp(1j * (np.abs(m1) ** 2) * dt)\n        p2 = np.fft.fft(m1) * np.exp(-0.5j * k ** 2 * half)\n        return np.fft.ifft(p2)\n\n    def fd_step(psi, dt):\n        lap = (np.roll(psi, 1) - 2 * psi + np.roll(psi, -1)) / (dx ** 2)\n        return psi + 1j * dt * (0.5 * lap + np.abs(psi) ** 2 * psi)\n\n    def norm2(p):\n        return float(np.real(np.sum(np.abs(p) ** 2) * dx))\n\n    def energy(p):\n        dp = np.gradient(p, dx)\n        kin = 0.5 * np.real(np.sum(np.abs(dp) ** 2) * dx)\n        pot = -0.25 * np.real(np.sum(np.abs(p) ** 4) * dx)\n        return kin + pot\n\n    def momentum(p):\n        dp = np.gradient(p, dx)\n        return float(np.real(np.sum(np.conj(p) * dp) * dx))\n\n    psi_s = psi0.copy()\n    psi_f = psi0.copy()\n    E0 = norm2(psi0)\n    Es = energy(psi0)\n    Ps = momentum(psi0)\n    max_err_s = 0.0\n    max_err_f = 0.0\n    l2_s = 0.0\n    l2_f = 0.0\n    drift_s = []\n    drift_f = []\n    relE_s = []\n    relE_f = []\n    relP_s = []\n    relP_f = []\n    peak = nx // 2\n\n    for n in range(nt):\n        ana = analytic(x, tgrid[n + 1])\n        psi_s = ssfm_step(psi_s, dt)\n        psi_f = fd_step(psi_f, dt)\n        d_s = np.abs(psi_s - ana)\n        d_f = np.abs(psi_f - ana)\n        max_err_s = max(max_err_s, float(np.max(d_s)))\n        max_err_f = max(max_err_f, float(np.max(d_f)))\n        l2_s = float(np.sum(d_s ** 2) * dx)\n        l2_f = float(np.sum(d_f ** 2) * dx)\n        arg_s = np.angle(psi_s[peak] / ana[peak])\n        arg_f = np.angle(psi_f[peak] / ana[peak])\n        drift_s.append(float(arg_s))\n        drift_f.append(float(arg_f))\n        relE_s.append(float((energy(psi_s) - Es) / Es))\n        relE_f.append(float((energy(psi_f) - Es) / Es))\n        relP_s.append(float((momentum(psi_s) - Ps) / Ps))\n        relP_f.append(float((momentum(psi_f) - Ps) / Ps))\n\n    t_vals = tgrid[1:]\n    slope_s = float(np.polyfit(t_vals, drift_s, 1)[0]) if len(t_vals) > 1 else 0.0\n    slope_f = float(np.polyfit(t_vals, drift_f, 1)[0]) if len(t_vals) > 1 else 0.0\n\n    return {\"success\": True,\n            \"summary\": {\"note\": \"SSFM vs FD phase drift for NLSE soliton\",\n                        \"ssfm_max_linf\": max_err_s,\n                        \"fd_max_linf\": max_err_f,\n                        \"ssfm_l2_final\": l2_s,\n                        \"fd_l2_final\": l2_f,\n                        \"ssfm_phase_slope\": slope_s,\n                        \"fd_phase_slope\": slope_f,\n                        \"ssfm_max_relE\": max(abs(v) for v in relE_s),\n                        \"fd_max_relE\": max(abs(v) for v in relE_f),\n                        \"ssfm_max_relP\": max(abs(v) for v in relP_s),\n                        \"fd_max_relP\": max(abs(v) for v in relP_f),\n                        \"N0\": E0, \"E0\": Es, \"P0\": Ps},\n            \"objectives\": {\"score\": float(max_err_f - max_err_s)}}"
    },
