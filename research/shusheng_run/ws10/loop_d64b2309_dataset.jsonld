    {
      "@type": "PropertyValue",
      "name": "generative_verify.reason",
      "value": "Output is a bare parameter dump with one numeric value (0.01953125, presumably L2 error) but no baseline, no convergence comparison, and no statement of what was validated. Cannot confirm correctness or that the claimed sech/SSFM setup actually produced this number. No data→inference→conclusion chain."
    },
    {
      "@type": "PropertyValue",
      "name": "generative_verify.needs_retry",
